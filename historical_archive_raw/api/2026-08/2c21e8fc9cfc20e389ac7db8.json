", \"auth_type\": \"oauth2\"}], \"push_to_mirrors\": false, \"measurement_unit_default\": \"metric\", \"plan_capabilities\": [\"can-set-site-public\", \"can-set-site-service-permissions\", \"can-view-export-history-report\", \"can-edit-basemap-terrain-settings\", \"can-set-scheduled-updates\", \"can-configure-published-map-viewers\", \"can-configure-esri-rest-api\", \"can-import-copc\", \"can-set-dataset-service-enabled\", \"can-configure-data-table-ui\", \"can-configure-spatial-query-ui\", \"can-view-all-reports\", \"can-request-sandbox\", \"can-request-sso\", \"can-request-custom-domain\", \"can-request-access-groups\", \"can-configure-additional-token-scopes\", \"can-create-crop-layers\", \"can-create-custom-licenses\", \"can-access-adhoc-services\", \"can-configure-vector-tile-pmtiles\", \"can-configure-vector-tile-pmtiles-ui\", \"can-configure-vector-tile-pmtiles-ui-to-all-users\"], \"allowed_source_types\": [\"arcgis\", \"cifs\", \"postgres\", \"s3\", \"upload\", \"wfs\"], \"product_boundaries\": {}, \"ga_key\": \"UA-23232486-2\", \"courier_enabled\": true, \"trial\": null, \"sandbox\": \"sandbox-2gxknc.koordinates.com\", \"is_custom_domain\": true}</script>\n  <script id=\"pre-cached-token\" type=\"application/json\">{\"id\": 5232479, \"name\": \"\", \"key_hint\": \"b9141a...\", \"url\": \"https://data.linz.govt.nz/services/api/v1.x/tokens/5232479/\", \"site\": \"*\", \"created_at\": \"2026-08-02T05:42:26.747453Z\", \"expires_at\": \"2026-08-02T11:42:25.896167Z\", \"scope\": \"query tiles\", \"referrers\": null, \"groups_scope\": [], \"key\": \"b9141a48ff28444ea3f2b526e11e4264\"}</script>\n\n  \n\n  <script>\n    window.preCachedData = [\n      {\n        url: \"/users/me/\",\n        data: JSON.parse(document.getElementById(\"pre-cached-user\").textContent),\n      },\n      {\n        url: \"/site/\",\n        data: JSON.parse(document.getElementById(\"pre-cached-site\").textContent),\n        expand: [\"tilegrids\"],\n      }\n    ];\n    let tokenData = JSON.parse(document.getElementById(\"pre-cached-token\").textContent);\n    if (tokenData) {\n      window.preCachedData.push({\n        url: \"/tokens/\",\n        data: tokenData,\n        method: \"POST\",\n      });\n    }\n  </script>\n\n  <script>\n    var lsBootFileKey = \"kx_boot_file\";\n    function getBootFileFromLS() {\n      const result = localStorage.getItem(lsBootFileKey);\n      if (result) {\n        return JSON.parse(result);\n      }\n      return result;\n    }\n\n    function storeBootFileToLS(bootFile) {\n      localStorage.setItem(lsBootFileKey, JSON.stringify(bootFile));\n    }\n\n    function getBootFileFromUrlParams() {\n      var params = new URLSearchParams(window.location.search);\n      if (params.has(\"matai-branch\") || params.has(\"sha\")) {\n        const slug = params.get(\"matai-branch\") || params.get(\"sha\");\n        const slugType = params.has(\"matai-branch\") ? \"branch\" : \"git\";\n        const url = \"kx.\" + slugType + \"-\" + slug + \".boot.js\";\n\n        return {\n          slug,\n          slugType,\n          url,\n        };\n      }\n    }\n\n    function getBootFileDetails() {\n      var defaultBootFile = {\n        slug: \"master\",\n        slugType: \"branch\",\n        url: \"boot.js\",\n      };\n\n      var urlBootFile = getBootFileFromUrlParams();\n      if (urlBootFile) {\n        return urlBootFile;\n      }\n\n      var lsBootFile = getBootFileFromLS();\n      if (lsBootFile) {\n        return lsBootFile;\n      }\n\n      const override = document.getElementById(\"boot-file-override\");\n      if (override) {\n        return JSON.parse(override.textContent);\n      }\n\n      return defaultBootFile;\n    }\n\n    function getBootFileUrl() {\n      var bootFile = getBootFileDetails();\n      if (bootFile.slug !== \"master\") {\n        createNotification();\n        storeBootFileToLS(bootFile);\n      }\n      return bootFile.url;\n    }\n\n    function createNotification() {\n      var bootFile = getBootFileDetails();\n      var el = document.createElement(\"div\");\n      el.style = \"height: 30px;background: white;padding: 2px 5px;z-index: 10;position: fixed;top: 0px;font-size: 12px;opacity: 0.7;line-height: 2;border: 1px solid red;\";\n      el.textContent = `${bootFile.slugType}: ${bootFile.slug}`;\n\n      var btn = document.createElement(\"button\");\n      btn.textContent = \"\ud83d\uddd1\";\n      btn.style = \"margin-left: 10px\";\n      btn.onclick = () => {\n        localStorage.removeItem(lsBootFileKey);\n        location.reload();\n      }\n      el.appendChild(btn);\n\n      document.body.appendChild(el);\n    }\n\n    var bootScript = document.createElement(\"script\");\n    bootScript.setAttribute(\"src\", \"https://assets.koordinates.com/fe/\" + getBootFileUrl());\n    document.body.appendChild(bootScript);\n  </script>\n\n</body>\n\n</html>",
