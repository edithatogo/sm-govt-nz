c\u200c\u200d\u200c\u200b\u200c\u200d\u200d\u200c\u200c\ufeff\u200c\u200b\u200c\u200d\ufeff\ufeff\u200c\ufeff\u200b\u200d\u200b\u200d\ufeff\ufeff\u200c\u200d\u200d\u200c\u200c\ufeff\u200c\u200b\u200c\u200d\u200c\u200c\u200c\u200d\ufeff\u200c\u200c\u200c\ufeff\ufeff\u200c\ufeff\u200c\u200b\u200c\ufeff\u200d\u200c\u200c\ufeff\u200b\u200b\u200c\u200d\u200c\u200c\u200c\ufeff\u200b\ufeff\u200b\u200d\ufeff\ufeff\u200b\ufeff\u200c\u200d\u200b\ufeff\u200b\u200d\u200b\ufeff\u200d\u200b\u200b\ufeff\u200c\u200b\u200b\ufeff\u200c\ufeff\u200b\ufeff\u200b\u200b\u200b\u200d\ufeff\ufeff\u200c\u200d\u200d\u200c\u200c\ufeff\u200c\u200b\u200c\u200d\u200c\u200c\u200c\u200d\ufeff\u200c\u200c\ufeff\u200b\ufeff\u200b\u200d\ufeff\ufeff\u200b\ufeff\u200b\u200c\u200b\ufeff\u200d\u200b\u200b\ufeff\u200d\u200c\u200b\ufeff\u200d\u200c\u200b\ufeff\u200c\u200d\u200b\ufeff\u200c\u200c\u200b\ufeff\u200b\u200c\u200b\ufeff\u200b\u200c\u200b\ufeff\u200c\u200d\u200b\u200d\ufeff\ufeff\u200c\u200d\u200c\u200c\u200c\u200d\u200c\u200b\u200c\u200d\u200d\u200c\u200c\ufeff\u200c\u200b\u200b\u200d\u200b\ufeff\u200c\u200d\u200c\u200d\u200c\u200d\u200d\u200c\u200c\u200d\u200c\u200c\u200c\u200d\ufeff\u200b\u200c\u200d\u200c\u200b\u200c\u200c\u200b\u200b\u200c\u200d\u200b\u200c\u200c\ufeff\u200c\u200b\u200c\u200d\u200d\u200b\u200b\ufeff\ufeff\u200c\u200c\ufeff\u200c\u200b\u200c\u200d\u200c\u200c\u200c\ufeff\u200b\u200d\u200c\u200d\ufeff\u200c\u200b\u200d\u200b\u200d\u200c\ufeff\ufeff\u200c, haka, and \u200b\u200b\u200b\u200b\u200c\ufeff\u200d\ufeff\u200b\u200d\u200b\u200d\u200c\u200d\ufeff\ufeff\u200c\ufeff\u200b\u200d\u200c\u200d\u200d\u200c\u200c\u200d\u200c\ufeff\u200c\u200d\u200d\u200c\u200c\u200d\ufeff\u200d\u200b\u200d\u200b\u200d\u200b\ufeff\u200d\u200d\u200b\u200d\u200b\u200d\u200c\u200d\u200c\u200b\u200c\u200d\u200b\u200c\u200c\ufeff\u200c\u200b\u200c\u200d\ufeff\ufeff\u200c\u200d\u200b\ufeff\u200c\u200d\ufeff\u200c\u200c\ufeff\u200b\ufeff\u200b\u200d\ufeff\u200d\u200c\u200d\u200b\ufeff\u200c\u200d\ufeff\