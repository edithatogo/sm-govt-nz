      {
        "base": "https://www.wananga.com/feed/rss2",
        "language": null,
        "type": "text/html",
        "value": "<div>\n  <h3>\n    <span>\n      \n           Front of House Manager -\n          \n    </span>\n    <span>\n      <span>\n        \n            CLOSED\n           \n      </span>\n    </span>\n  </h3>\n  <h5>\n    <span>\n      \n           Ng\u0101 Purapura Caf\u00e9, \u014ctaki\n          \n    </span>\n  </h5>\n</div>\n<div>\n  <p>\n    <span>\n      \n           Te W\u0101nanga o Raukawa is seeking a reliable and friendly\u00a0\n          \n    </span>\n    <strong>\n      \n           Front of House Manager\n          \n    </strong>\n    <span>\n      \n           \u00a0to join\u00a0\n          \n    </span>\n    <strong>\n      \n           Ng\u0101 Purapura Caf\u00e9\n          \n    </strong>\n    <span>\n      \n           .\n          \n    </span>\n  </p>\n  <p>\n    <span>\n      \n           This role supports the daily running of the caf\u00e9, working closely with the Cook to ensure great service, smooth operations, and a welcoming environment.\n          \n    </span>\n  </p>\n  <p>\n    <span>\n      <br />\n    </span>\n  </p>\n  <p>\n    <strong>\n      \n           M\u0101u e mau mai:\n          \n    </strong>\n  </p>\n  <ul>\n    <li>\n      <span>\n        \n            Hospitality experience or relevant qualifications\n           \n      </span>\n    </li>\n    <li>\n      <span>\n        \n            Strong customer service and communication skills (English and some te reo M\u0101ori or willingness to learn)\n           \n      </span>\n    </li>\n    <li>\n      <span>\n        \n            Ability to multitask, work under pressure, and support kitchen operations\n           \n      </span>\n    </li>\n    <li>\n      <span>\n        \n            A reliable, friendly and team-focused attitude\n           \n      </span>\n    </li>\n  </ul>\n  <p>\n    <span>\n      <br />\n    </span>\n  </p>\n  <p>\n    <strong>\n      \n           Ka tukuna e m\u0101tou:\n          \n    </strong>\n  </p>\n  <ul>\n    <li>\n      <span>\n        \n            A kaupapa-driven, supportive work environment\n           \n      </span>\n    </li>\n    <li>\n      <span>\n        \n            The chance to work in a values-based organisation serving our community\n           \n      </span>\n    </li>\n  </ul>\n  <p>\n    <br />\n  </p>\n  <p>\n    <span>\n      <span>\n        \n            \ufeff\n           \n      </span>\n      \n           Join our team and help deliver great kai and great manaakitanga every day.\n          \n    </span>\n  </p>\n  <p>\n    <br />\n  </p>\n  <p>\n    <strong>\n      \n           Applications close:\u00a0\n          \n    </strong>\n    <span>\n      \n           Friday 6 Feb, 2026\n          \n    </span>\n  </p>\n  <p>\n    <br />\n  </p>\n  <p>\n    <span>\n      \n           For further information or to apply for this role, please contact:\n          \n    </span>\n  </p>\n  <p>\n    <br />\n  </p>\n  <p>\n    <span>\n      \n           Dionne Seng, Kaihaut\u016b Te Whare Tiaki Rawa\n          \n    </span>\n  </p>\n  <p>\n    <span>\n      \n           \u012am\u0113ra:\u00a0\n          \n    </span>\n    <a href=\"mailto:dionne.seng@twor-otaki.ac.nz\" target=\"_blank\">\n      \n           dionne.seng@twor-otaki.ac.nz\n          \n    </a>\n  </p>\n  <p>\n    <span>\n      \n           Waea: 06 364 9011\n           \n      <br />\n    </span>\n  </p>\n</div>"
      }
    ],
