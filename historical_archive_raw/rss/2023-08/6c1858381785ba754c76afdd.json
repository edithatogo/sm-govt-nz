      {
        "base": "https://www.wananga.com/feed/atom",
        "language": null,
        "type": "text/plain",
        "value": "<div>\r\n  <img src=\"https://irp.cdn-website.com/002b888d/dms3rep/multi/pexels-irina-iriser-943901.jpg\" alt=\"\"/>\r\n</div>\r\n<div data-rss-type=\"text\">\r\n  <p>\r\n    <span>\r\n      \n           Shoebox Christmas Aotearoa Sponsorship\n          \r\n    </span>\r\n  </p>\r\n  <p>\r\n    <br/>\r\n  </p>\r\n  <p>\r\n    <span>\r\n      <span>\r\n        \n            Te W\u0101nanga o Raukawa is pleased to be joining with Shoebox Christmas Aotearoa as principal sponsor.\u00a0\n           \r\n      </span>\r\n    </span>\r\n  </p>\r\n  <p>\r\n    <br/>\r\n  </p>\r\n  <p>\r\n    <span>\r\n      <span>\r\n        \n            Shoebox Christmas Aotearoa has been providing opportunities for New Zealanders to share their generosity and concern for others, specifically tamariki by providing gifts at Christmas since 2014. Their slogan is \u201cBecause every kiwi kid deserves a choice Christmas\u201d. Shoebox Christmas Aotearoa was developed by Pera Barrett of \u014ctaki. It delivers Christmas presents, wrapped in a shoebox to tamariki in need on Christmas Day. Shoebox Christmas Aotearoa does this by working alongside schools, pre-schools, Women's Refuge, and community organisations who identify the tamariki who receive the boxes.\u00a0\n           \r\n      </span>\r\n    </span>\r\n  </p>\r\n  <p>\r\n    <br/>\r\n  </p>\r\n  <p>\r\n    <span>\r\n      \n           Aside from this, Shoebox Christmas Aotearoa has been offering rangatahi opportunities to learn valuable skills by leading a project, communicating efficiently, using data effectively and modelling from a values-based approach. The long-term vision for the sponsorship by Te W\u0101nanga o Raukawa is to develop, nurture and build the relationship with Shoebox Christmas Aotearoa into a pathway for rangatahi from kura to w\u0101nanga and the development of a degree with a clear pathway into any one of Te W\u0101nanga o Raukawa\u2019 postgraduate options.\u00a0\n          \r\n    </span>\r\n  </p>\r\n  <p>\r\n    <span>\r\n      <span>\r\n        \n            \u00a0\n           \r\n      </span>\r\n    </span>\r\n  </p>\r\n  <p>\r\n    <br/>\r\n  </p>\r\n  <p>\r\n    <span>\r\n      \n           For more information contact:\u00a0\n          \r\n    </span>\r\n  </p>\r\n  <p>\r\n    <span>\r\n      \n           \u00a0\n          \r\n    </span>\r\n  </p>\r\n  <p>\r\n    <span>\r\n      \n           Marama Bevan, Kaihaut\u016b, Te Whare T\u016bhono\u00a0\n          \r\n    </span>\r\n  </p>\r\n  <p>\r\n    <span>\r\n      \n           06 364 9011 xtn 844\u00a0\n          \r\n    </span>\r\n  </p>\r\n  <p>\r\n    <a href=\"mailto:Marama.Bevan@twor-otaki.ac.nz\" target=\"_blank\">\r\n      \n           Marama.Bevan@twor-otaki.ac.nz\n          \r\n    </a>\r\n    <span>\r\n      \n           \u00a0\n          \r\n    </span>\r\n  </p>\r\n  <p>\r\n    <span>\r\n      \n           \u00a0Or \u00a0\n          \r\n    </span>\r\n  </p>\r\n  <p>\r\n    <span>\r\n      \n           Pera Barrett, Shoebox Christmas Aotearoa\u00a0\n          \r\n    </span>\r\n  </p>\r\n  <p>\r\n    <a href=\"mailto:Pera.barrett@gmail.com\" target=\"_blank\">\r\n      \n           Pera.barrett@gmail.com\n          \r\n    </a>\r\n    <span>\r\n      \n           \u00a0\n           \r\n      <br/>\r\n    </span>\r\n  </p>\r\n  <p>\r\n    <span>\r\n      <br/>\r\n    </span>\r\n  </p>\r\n</div>\r\n<div>\r\n  <img src=\"https://irp.cdn-website.com/002b888d/dms3rep/multi/pexels-irina-iriser-943901.jpg\" alt=\"\"/>\r\n</div>"
      }
