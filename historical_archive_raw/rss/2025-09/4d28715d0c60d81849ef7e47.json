      {
        "base": "https://www.wananga.com/feed/rss2",
        "language": null,
        "type": "text/html",
        "value": "<div>\n  <h3>\n    <span>\n      \n           60th National Ng\u0101 Manu K\u014drero Speech Competitions\n          \n    </span>\n  </h3>\n</div>\n<div>\n  <img src=\"https://irp.cdn-website.com/002b888d/dms3rep/multi/IMG_4599.jpg\" />\n</div>\n<div>\n  <p>\n    <span>\n      \n           Te W\u0101nanga o Raukawa was honoured to stand alongside the next generation of M\u0101ori leaders as one of the sponsors of the 60th National Ng\u0101 Manu K\u014drero Speech Competitions, held in Whanganui from 16\u201318 September.\n          \n    </span>\n  </p>\n  <p>\n    <br />\n  </p>\n  <p>\n    <span>\n      \n           As part of our commitment to nurturing m\u0101tauranga and leadership, we offered Karahipi M\u0101tauranga \u2013 Te W\u0101nanga o Raukawa Scholarships to the winners of two prestigious categories:\n          \n    </span>\n  </p>\n  <p>\n    <br />\n  </p>\n  <p>\n    <strong>\n      \n           Te R\u0101whiti \u012ahaka (Junior M\u0101ori)\n          \n    </strong>\n  </p>\n  <p>\n    <strong>\n      \n           Pei Te Hurinui Jones (Senior M\u0101ori)\n          \n    </strong>\n  </p>\n  <p>\n    <br />\n  </p>\n  <p>\n    <span>\n      <span>\n        \n            We\u2019re thrilled to congratulate this year\u2019s scholarship recipients:\n            \n        <br />\n        \n            \u00a0\n            \n        <br />\n      </span>\n    </span>\n  </p>\n  <p>\n    <strong>\n      \n           Atareta Milne\n          \n    </strong>\n    <span>\n      <span>\n        \n            \u00a0\u2013 Te Kura o Te Koutu, Rotorua (Junior M\u0101ori)\n            \n        <br />\n      </span>\n    </span>\n    <strong>\n      \n           Te Kahurangi Teinakore-Huaki\n          \n    </strong>\n    <span>\n      \n           \u00a0\u2013 Te Wharekura o Kirikiriroa, Hamilton (Senior M\u0101ori)\n          \n    </span>\n  </p>\n  <p>\n    <br />\n  </p>\n  <p>\n    <span>\n      \n           To all the rangatahi who took the stage with courage, skill, and mana \u2013 your voices uplift and inspire. Ka mau te wehi!\n          \n    </span>\n  </p>\n</div>\n<div>\n  <img alt=\"\" src=\"https://irp.cdn-website.com/002b888d/dms3rep/multi/IMG_4608-2.jpg\" />\n</div>\n<div>\n  <img alt=\"\" src=\"https://irp.cdn-website.com/002b888d/dms3rep/multi/IMG_4617-3-b544366a.jpg\" />\n</div>"
      }
    ],
