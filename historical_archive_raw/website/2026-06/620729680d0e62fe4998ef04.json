.toLowerCase();\n      const bText = b.querySelector('a').textContent.trim().toLowerCase();\n      return aText.localeCompare(bText);\n    });\n\n    // Rebuild list\n    ul.innerHTML = '';\n    fixedItems.forEach(li => ul.appendChild(li));\n    sortableItems.forEach(li => ul.appendChild(li));\n\n  });\n\n});\n</script>\n\r\n</section>\r\n<div class=\"cd-main-content\">\r\n<section class=\"covid-alert\"></section>\r\n<section class=\"home-header\">\r\n\t<div class=\"wrapper-lg\">\r\n\t\t\r\n\r\n<div id=\"home\" class=\"flex-fluid stretch\">\r\n\t\r\n<div class=\"whatsnew\">\r\n\t<article><h2>Alerts:</h2>\r\n<p>&nbsp;</p>\r\n<ul>\r\n<li><a href=\"https://www.kaipara.govt.nz/slg\">Find out more about Simplifying Local Government</a></li>\r\n<li><a href=\"https://www.kaipara.govt.nz/es-review\">Feedback open on Engineering Standards</a></li>\r\n<li><a href=\"panel\">Sign up to the People's Panel to&nbsp;receive council surveys via email</a></li>\r\n<li><a title=\"Follow new Check, Clean, Dry rules before arriving at Taharoa Domain\" href=\"https://www.nrc.govt.nz/environment/weed-and-pest-control/pest-control-hub/animal/invasive-freshwater-clam/\" target=\"_blank\">Follow Check, Clean, Dry rules for&nbsp;Taharoa Domain</a></li>\r\n<li><a href=\"https://www.kaipara.govt.nz/nw\" target=\"_blank\">Information about Northland Waters</a></li>\r\n<!--li><a href=\"http://eepurl.com/hemjzz\" target=\"_blank\">Subscribe to our Council e-newsletter</a></li--></ul>\r\n\r\n\r\n</article></div>\r\n<div class=\"banner-wrapper flex\">\r\n<div class=\"images images--news\">\r\n<div class=\"flexslider\">\r\n\n<ul class=\"slides slides--news\">\n      <li>\n      <div class=\"slides__img\">\n          <img src=\"/images/blog/large/1008_Powhiri Otamatea marae_CE Jazz Singh 20260622 (3).jpg\" alt=\"P\u014dwhiri in district\u2019s heartland welcomes new chief executive\" />\n          <a class=\"slides__img-link\" href=\"/news/post/1008-P-whiri-in-district-s-heartland-welcomes-new-chief-executive\"> </a>\n      </div>\n      <div class=\"slides__details\">\n                <a class=\"slides__link\" href=\"/news/post/1008-P-whiri-in-district-s-heartland-welcomes-new-chief-executive\"> <h2>P\u014dwhiri in district\u2019s heartland welcomes new chief executive</h2></a>\n          <a class=\"slides__summary\" href=\"/news/post/1008-P-whiri-in-district-s-heartland-welcomes-new-chief-executive\">A p\u014dwhiri held at Otamatea marae has formally welcomed Kaipara District Council&rsquo;s new chief executive, Jazz Singh.</a>\n          <div class=\"btn-wrap\">\n          <a class=\"slides__more slider-button-main\" href=\"/news/post/1008-P-whiri-in-district-s-heartland-welcomes-new-chief-executive\">Read more</a>\n          <a class=\"slides__more slider-button-main\" href=\"/news\">Latest news</a>\n</div>\n      </div>\n  </li>\n      <li>\n      <div class=\"slides__img\">\n          <img src=\"/images/blog/large/1007_Pahi Playground opening_20260620 (2)_edited.JPG\" alt=\"A new place to play for Pahi\" />\n          <a class=\"slides__img-link\" href=\"/news/post/1007-A-new-place-to-play-for-Pahi\"> </a>\n      </div>\n      <div class=\"slides__details\">\n                <a class=\"slides__link\" href=\"/news/post/1007-A-new-place-to-play-for-Pahi\"> <h2>A new place to play for Pahi</h2></a>\n          <a class=\"slides__summary\" href=\"/news/post/1007-A-new-place-to-play-for-Pahi\">Pahi&rsquo;s new playground is now open, giving local and visiting children a fun new place to play, explore and let their imaginations run wild.&nbsp;</a>\n          <div class=\"btn-wrap\">\n          <a class=\"slides__more slider-button-main\" href=\"/news/post/1007-A-new-place-to-play-for-Pahi\">Read more</a>\n          <a class=\"slides__more slider-button-main\" href=\"/news\">Latest news</a>\n</div>\n      </div>\n  </li>\n      <li>\n      <div class=\"slides__img\">\n          <img src=\"/images/blog/large/1006_20260524_113113_approved.jpg\" alt=\"Mangawhai Road closure for slip site repairs\" />\n          <a class=\"slides__img-link\" href=\"/news/post/1006-Mangawhai-Road-closure-for-slip-site-repairs\"> </a>\n      </div>\n      <div class=\"slides__details\">\n                <a class=\"slides__link\" href=\"/news/post/1006-Mangawhai-Road-closure-for-slip-site-repairs\"> <h2>Mangawhai Road closure for slip site repairs</h2></a>\n          <a class=\"slides__summary\" href=\"/news/post/1006-Mangawhai-Road-closure-for-slip-site-repairs\">Mangawhai Road between Coal Hill Road and Cames Road will be under a 24/7 closure from 6am on Saturday 20 June until 6pm on Sunday 5 July, to allow road crews to make urgent repairs at the slip site.&nbsp;</a>\n          <div class=\"btn-wrap\">\n          <a class=\"slides__more slider-button-main\" href=\"/news/post/1006-Mangawhai-Road-closure-for-slip-site-repairs\">Read more</a>\n          <a class=\"slides__more slider-button-main\" href=\"/news\">Latest news</a>\n</div>\n      </div>\n  </li>\n      <li>\n      <div class=\"slides__img\">\n          <img src=\"/images/blog/large/1005_Holy Anglican Church_Maungat\u016broto_side view 2026.jpeg\" alt=\"Maungat\u016broto Library finds temporary home\" />\n          <a class=\"slides__img-link\" href=\"/news/post/1005-Maungat-roto-Library-finds-temporary-home\"> </a>\n      </div>\n      <div class=\"slides__details\">\n                <a class=\"slides__link\" href=\"/news/post/1005-Maungat-roto-Library-finds-temporary-home\"> <h2>Maungat\u016broto Library finds temporary home</h2></a>\n          <a class=\"slides__summary\" href=\"/news/post/1005-Maungat-roto-Library-finds-temporary-home\">The Maungat\u016broto Community Library will soon reopen in the Holy Trinity Anglican Church.</a>\n          <div class=\"btn-wrap\">\n          <a class=\"slides__more slider-button-main\" href=\"/news/post/1005-Maungat-roto-Library-finds-temporary-home\">Read more</a>\n          <a class=\"slides__more slider-button-main\" href=\"/news\">Latest news