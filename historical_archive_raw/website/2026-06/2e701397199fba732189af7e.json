=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript><div id=\"__next\"></div><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"props\":{\"pageProps\":{\"responseData\":{\"success\":true,\"message\":\"\",\"status\":200,\"data\":{\"id\":1,\"backLink\":[],\"title\":\"Home\",\"metaTitle\":\"Human Rights Commission\",\"metaDescription\":\"All people in Aotearoa New Zealand have the right to dignity, equality and respect.\",\"canonical\":\"https://tikatangata.org.nz/?token=03f66278f1accf53688cff9e86f396f748e70e3e35f4c5f9c6e566b118699f59\",\"ogMeta\":[{\"key\":\"og:title\",\"value\":\"Human Rights Commission\"},{\"key\":\"og:description\",\"value\":\"All people in Aotearoa New Zealand have the right to dignity, equality and respect.\"},{\"key\":\"og:url\",\"value\":\"https://tikatangata.org.nz/?token=03f66278f1accf53688cff9e86f396f748e70e3e35f4c5f9c6e566b118699f59\"}],\"pageType\":\"HomePage\",\"blocks\":[{\"id\":2,\"blockType\":\"ElementInfoCards\",\"data\":{\"content\":{\"title\":\"All people in Aotearoa New Zealand have the right to dignity, equality and respect. \",\"description\":\"Te\u00a0K\u0101hui\u00a0Tika\u00a0Tangata\u00a0Human Rights Commission works to make this a reality.\",\"link\":{\"label\":\"Learn what we do\",\"to\":\"/about-us/what-we-do\",\"target\":\"\",\"anchor\":\"\",\"isInternal\":true}},\"cardItems\":[{\"title\":\"Learn about human rights\",\"description\":\"Human rights are the basic rights and freedoms that everyone should enjoy in Aotearoa New Zealand.\",\"link\":{\"label\":\"Human Rights Handbook\",\"to\":\"/human-rights-in-aotearoa\",\"target\":\"\",\"anchor\":\"\",\"isInternal\":true}},{\"title\":\"Learn how to make a complaint\",\"description\":\"A pathway is available to the public to complain about unlawful discrimination and prohibited behaviour.\",\"link\":{\"label\":\"Make a complaint\",\"to\":\"/resources-and-support/make-a-complaint\",\"target\":\"\",\"anchor\":\"\",\"isInternal\":true}},{\"title\":\"Learn how we can help\",\"description\":\"A range of other services are available if you have experienced discrimination or harmful speech and more.\",\"link\":{\"label\":\"How We Can Help\",\"to\":\"/about-us/how-we-can-help\",\"target\":\"\",\"anchor\":\"\",\"isInternal\":true}},{\"title\":\"Meet our Commissioners\",\"description\":\"The Commission can have four Human Rights Commissioners at one time. Learn more about who they are and what they do.\",\"link\":{\"label\":\"Our People\",\"to\":\"/about-us/our-people\",\"target\":\"\",\"anchor\":\"\",\"isInternal\":true}}]}},{\"id\":17,\"blockType\":\"ElementImageWithTextBlock\",\"data\":{\"content\":{\"title\":\"About Us\",\"showTitle\":0,\"description\":\"Te K\u0101hui Tika Tangata Human Rights Commission is Aotearoa New Zealand's National Human Rights Institution committed to a holistic expression of Te Tiriti o Waitangi and human rights including tino rangatiratanga, respectful relationships, shared responsibilities, and rights activation. \"},\"imagePosition\":\"right\",\"image\":\"/cms/assets/Images/Indigenous-Rights-Images/People-walking-into-a-Marae-for-a-porwhiri__FocusFillWyIwLjAwIiwiMC4wMCIsMTUwMCw5MDBd.webp\",\"cta\":{\"label\":\"Learn about the Commission\",\"to\":\"/about-us\",\"target\":\"\",\"anchor\":\"\",\"isInternal\":true}}},{\"id\":23,\"blockType\":\"ElementCTA\",\"data\":{\"content\":{\"title\":\"Sign up to our monthly newsletter \",\"showTitle\":true,\"description\":null},\"ctaPosition\":\"right\",\"cta\":{\"label\":\"Sign up\",\"to\":\"/newsletter-sign-up\",\"target\":\"_blank\",\"anchor\":\"\",\"isInternal\":true}}},{\"id\":595,\"blockType\":\"ElementFeaturedResourcePages\",\"data\":{\"content\":{\"title\":\"Key projects and stories\",\"description\":\"\\u003cp\\u003eMajor projects and publications by\\u0026nbsp;Te\\u0026nbsp;K\u0101hui\\u0026nbsp;Tika\\u0026nbsp;Tangata\\u0026nbsp;Human Rights Commission\\u003c/p\\u003e\",\"link\":{\"label\":\"View all work\",\"to\":\"/our-work\",\"target\":\"\",\"anchor\":\"\",\"isInternal\":true}},\"featuredItems\":[{\"image\":\"/cms/assets/Images/Rainbow-Images/trans-flag1__FocusFillWyIwLjAwIiwiMC4wMCIsMTQwMCw4MDBd.png\",\"title\":\"Trans Rights are Human Rights guide\",\"resourceType\":\"Publication\",\"description\":\"\\u003cp\\u003eThis resource provides some information about the rights of transgender people. It should not be regarded as legal advice.\\u003c/p\\u003e\",\"link\":{\"label\":\"Trans Rights are Human Rights guide\",\"to\":\"/our-work/trans-rights-guide\",\"target\":\"\",\"isInternal\":true},\"lastUpdatedAt\":\"15 April 2026\",\"overridePublishedDate\":\"25 June 2024\",\"createdAt\":\"05 June 2024\",\"tags\":[\"Rights of Sexual and Gender Minorities\"]},{\"image\":\"/cms/assets/Images/Work-Images/Construction-workers-in-Christchurch__FocusFillWyIwLjAwIiwiMC4wMCIsMTQwMCw4MDBd.webp\",\"title\":\"New review: Migrant workers being exploited in AEWV work visa scheme\",\"resourceType\":\"Article\",\"description\":\"\\u003cp\\u003eFrom non-existent jobs and wages to the potential for human trafficking \u2013 migrant workers are being exploited.\\u003c/p\\u003e\",\"link\":{\"label\":\"New review: Migrant workers being exploited in AEWV work visa scheme\",\"to\":\"/news/migrant-worker-exploitation\",\"target\":\"\",\"isInternal\":true},\"lastUpdatedAt\":\"19 February 2026\",\"overridePublishedDate\":\"16 August 2024\",\"createdAt\":\"16 August 2024\",\"tags\":[\"Right to Work\"]},{\"image\":\"/cms/assets/Images/Misc-Stock-Images/Lecturn_Stock__FocusFillWyIwLjAwIiwiMC4wMCIsMTQwMCw4MDBd.jpg\",\"title\":\"Proposed legislation on M\u0101ori wards discriminatory, says Commission\",\"resourceType\":\"Article\",\"description\":\"\\u003cp\\u003eCommission calls for moves to reinstate polls on M\u0101ori wards to be dropped.\\u003c/p\\u003e\",\"link\":{\"label\":\"Proposed legislation on M\u0101ori wards discriminatory, says Commission\",\"to\":\"/our-work/proposed-legislation-on-maori-wards-discriminatory-says-commission\",\"target\":\"\",\"isInternal\":true},\"lastUpdatedAt\":\"06 June 2024\",\"overridePublishedDate\":\"06 June 2024\",\"createdAt\":\"06 June 2024\",\"tags\":[\"Democratic Rights \"]},{\"image\":\"/cms/assets/Images/Rainbow-Images/123246278_l__FocusFillWyIwLjAwIiwiMC4wMCIsMTQwMCw4MDBd.jpg\",\"title\":\"New study: support needed by people escaping religious conversion practices   \",\"resourceType\":\"Article\",\"description\":\"\\u003cp\\u003eSurvivors of religious conversion practices have identified a range of support needed before, during and after escaping the abuse.\\u003c/p\\u003e\",\"link\":{\"label\":\"New study: support needed by people escaping religious conversion practices   \",\"to\":\"/news/new-study-support-needed-by-people-escaping-religious-conversion-practices\",\"target\":\"\",\"isInternal\":true},\"lastUpdatedAt\":\"12 December 2024\",\"overridePublishedDate\":\"02 May 2024\",\"createdAt\":\"02 May 2024\",\"tags\":[\"Freedom of Opinion  and Expression\"]},{\"image\":\"/cms/assets/Images/Race-Religion/KEEN-TO-SKYDIVE-LOVE-CRICKET-OUTDOORS-PEOPLE-2-1__FocusFillWyIwLjAwIiwiMC4wMCIsMTQwMCw4MDBd.jpg\",\"title\":\"We All Belong Here \",\"resourceType\":\"Campaign\",\"description\":\"\\u003cp\\u003eThis month we celebrate Race Relations Day, no matter your culture or background we all have things in common.\\u003c/p\\u003e\",\"link\":{\"label\":\"We All Belong Here \",\"to\":\"/our-work/we-all-belong-here\",\"target\":\"\",\"isInternal\":true},\"lastUpdatedAt\":\"15 April 2026\",\"overridePublishedDate\":\"21 March 2024\",\"createdAt\":\"20 March 2024\",\"tags\":[null]},{\"image\":\"/cms/assets/Images/HRC-Portraits/PHOTO-2024-02-13-12-34-57__FocusFillWyIwLjAwIiwiMC4wMCIsMTQwMCw4MDBd.jpeg\",\"title\":\"New Zealand's human rights record - Universal Periodic Review 2024\",\"resourceType\":\"Article\",\"description\":\"\\u003cp\\u003eNew Zealand\u2019s human rights record is reviewed by the UN as part of a Universal Periodic Review - find out about the 2024 review.\\u003c/p\\u003e\",\"link\":{\"label\":\"New Zealand's human rights record - Universal Periodic Review 2024\",\"to\":\"/our-work/upr\",\"target\":\"\",\"isInternal\":true},\"lastUpdatedAt\":\"15 February 2024\",\"overridePublishedDate\":\"09 February 2024\",\"createdAt\":\"30 August 2023\",\"tags\":[\"Democratic Rights \"]},{\"image\":\"/cms/assets/Images/HRC-Portraits/Meg-Claire-at-powhiri__FocusFillWyIwLjAwIiwiMC4wMCIsMTQwMCw4MDBd.webp\",\"title\":\"Revealing poll shows people see te Tiriti o Waitangi as partnership\",\"resourceType\":\"Article\",\"description\":\"\\u003cp\\u003eCommission's poll highlights people want\\u003cspan\\u003e\\u0026nbsp;M\u0101ori and non-M\u0101ori to decide together how te Tiriti o Waitangi is honoured.\\u003c/span\\u003e\\u003c/p\\u003e\",\"link\":{\"label\":\"Revealing poll shows people see te Tiriti o Waitangi as partnership\",\"to\":\"/news/revealing-poll-shows-people-see-te-tiriti-o-waitangi-as-partnership\",\"target\":\"\",\"isInternal\":true},\"lastUpdatedAt\":\"22 November 2023\",\"overridePublishedDate\":\"22 November 2023\",\"createdAt\":\"22 November 2023\",\"tags\":[\"Democratic Rights \"]},{\"image\":\"/cms/assets/Images/Chief-Human-Rights-Commissioner-Paul-Hunt-speaking__FocusFillWyIwLjAwIiwiMC4wMCIsMTQwMCw4MDBd.jpg\",\"title\":\"How should the new government approach the Israel Gaza conflict?\",\"resourceType\":\"Article\",\"description\":\"\\u003cp\\u003eChief Commissioner Paul Hunt provides his take on the way forward for Aotearoa New Zealand on the Israel-Palestine conflict.\\u003c/p\\u003e\",\"link\":{\"label\":\"How should the new government approach the Israel Gaza conflict?\",\"to\":\"/news/how-should-the-new-government-approach-the-israel-gaza-conflict\",\"target\":\"\",\"isInternal\":true},\"lastUpdatedAt\":\"21 November 2023\",\"overridePublishedDate\":\"21 November 2023\",\"createdAt\":\"21 November 2023\",\"tags\":[\"Life, Liberty and  Security of Person\"]},{\"image\":\"/cms/assets/Images/HRC-Portraits/Powhiri-image-for-co-gov-resource__FocusFillWyIwLjAwIiwiMC4wMCIsMTQwMCw4MDBd.webp\",\"title\":\"Co-governance, human rights and Te Tiriti o Waitangi\",\"resourceType\":\"Publication\",\"description\":\"\\u003cp\\u003eFind out about\\u0026nbsp;\\u003cspan class=\\\"TextRun SCXW150224529 BCX0\\\"\\u003e\\u003cspan class=\\\"NormalTextRun SCXW150224529 BCX0\\\"\\u003ethe link between human rights, te Tiriti o Waitangi \\u0026amp; co-governance.\\u003c/span\\u003e\\u003c/span\\u003e\\u003c/p\\u003e\",\"link\":{\"label\":\"Co-governance, human rights and Te Tiriti o Waitangi\",\"to\":\"/our-work/co-governance-resource\",\"target\":\"\",\"isInternal\":true},\"lastUpdatedAt\":\"15 April 2026\",\"overridePublishedDate\":\"06 November 2023\",\"createdAt\":\"06 November 2023\",\"tags\":[\"Democratic Rights \"]}]}},{\"id\":593,\"blockType\":\"ElementFeaturedResourcePages\",\"data\":{\"content\":{\"title\":\"Guidelines\",\"description\":\"\\u003cdiv class=\\\"basis-full lg:basis-8/12\\\"\\u003e\\n\\u003cdiv class=\\\"mt-desktopBtSmallHeadingAndText lg:mt-desktopBtHeadingAndText wysiwyg-content\\\"\\u003e\\n\\u003cp\\u003e\\u003cspan\\u003eInformation booklets and how-to guides for individuals, organisations and the public sector.\\u003c/span\\u003e\\u003c/p\\u003e\\n\\u003c/div\\u003e\\n\\u003c/div\\u003e\",\"link\":{\"label\":\"View more guidelines\",\"to\":\"/resources-and-support/guidelines\",\"target\":\"\",\"anchor\":\"\",\"isInternal\":true}},\"featuredItems\":[{\"image\":\"/cms/assets/Images/Rainbow-Images/Three-people-wearing-rainbow-flags-in-a-march__FocusFillWyIwLjAwIiwiMC4wMCIsMTQwMCw4MDBd.webp\",\"title\":\"Conversion Practices Guidelines\",\"resourceType\":\"Resource\",\"description\":\"\\u003cp\\u003eGuidelines on practices that seek to change or suppress a person\u2019s sexual orientation, gender identity\\u0026nbsp;or\\u003cspan\\u003e\\u0026nbsp;gender expression.\\u003c/span\\u003e\\u003c/p\\u003e\",\"link\":{\"label\":\"Conversion Practices Guidelines\",\"to\":\"/resources-and-support/guidelines/guidelines-on-conversion-practices\",\"target\":\"\",\"isInternal\":true},\"lastUpdatedAt\":\"26 January 2023\",\"overridePublishedDate\":\"18 August 2022\",\"createdAt\":\"11 January 2023\",\"tags\":[\"Rights of Sexual and Gender Minorities\"]},{\"image\":\"/cms/assets/Images/Childrens-Rights/Group-of-school-children-playing-rock-paper-scissors__FocusFillWyIwLjAwIiwiMC4wMCIsMTQwMCw4MDBd.webp\",\"title\":\"School Uniform Guidelines\",\"resourceType\":\"Resource\",\"description\":\"\\u003cp\\u003eGuidelines on\\u0026nbsp;school uniform policies for schools in Aotearoa New Zealand.\\u003c/p\\u003e\",\"link\":{\"label\":\"School Uniform Guidelines\",\"to\":\"/resources-and-support/guidelines/guidelines-on-school-uniform-policies\",\"target\":\"\",\"isInternal\":true},\"lastUpdatedAt\":\"01 February 2023\",\"overridePublishedDate\":\"11 January 2023\",\"createdAt\":\"11 January 2023\",\"tags\":[\"Right to Education \"]},{\"image\":\"/cms/assets/Images/Women/IMM-Reasonable-Accommodation-Guide-image__FocusFillWyIwLjAwIiwiMC4wMCIsMTQwMCw4MDBd.JPG\",\"title\":\"Reasonable Accommodation Guidelines\",\"resourceType\":\"Resource\",\"description\":\"\\u003cp\\u003eRemoving barriers: A guide for reasonable accommodation of disabled people in Aotearoa\\u003c/p\\u003e\",\"link\":{\"label\":\"Reasonable Accommodation Guidelines\",\"to\":\"/resources-and-support/guidelines/reasonable-accommodation-guidelines\",\"target\":\"\",\"isInternal\":true},\"lastUpdatedAt\":\"08 March 2023\",\"overridePublishedDate\":\"27 February 2023\",\"createdAt\":\"25 January 2023\",\"tags\":[\"Rights of Disabled People\"]}]}},{\"id\":12,\"blockType\":\"ElementFeaturedAccordionItems\",\"data\":{\"content\":{\"title\":\"Questions and answers\",\"showTitle\":true,\"description\":\"\"},\"cta\":{\"label\":\"View all questions and answers\",\"to\":\"/resources-and-support/frequently-asked-questions\",\"target\":\"\",\"anchor\":\"\",\"isInternal\":true},\"image\":\"/cms/assets/Images/HRC-Portraits/Paul-Hunt/Paul-Hunt-looking-across-a-table-at-two-people-with-the-back-of-their-heads-showing__FocusFillWyIwLjAwIiwiMC4wMCIsMTUwMCw5MDBd..webp\",\"accordionItems\":[{\"attrId\":\"what-can-i-be-asked-in-a-job-interview-\",\"title\":\"What can I be asked in a job interview? \",\"description\":\"\\u003cp\\u003eAn employer should only ask you questions relevant to the job you\u2019re applying for.\\u003c/p\\u003e\\u003cp\\u003eEmployers should not generally ask questions about your:\\u003c/p\\u003e\\u003cul\\u003e\\n\\u003cli\\u003eage \u2013 unless it is necessary for the purposes of the\\u0026nbsp;Minimum Wages Act\\u0026nbsp;or the\\u0026nbsp;Sale of Liquor Act\\u003c/li\\u003e\\n\\u003cli\\u003edate of birth\\u003c/li\\u003e\\n\\u003cli\\u003epast or current health status\\u003c/li\\u003e\\n\\u003cli\\u003eACC claims history\\u003c/li\\u003e\\n\\u003cli\\u003epartner, children or other dependents\\u003c/li\\u003e\\n\\u003cli\\u003epast or present experience of family/domestic violence (\\u003ca title=\\\"Rights for employees affected by domestic violence\\\" rel=\\\"noopener noreferrer\\\" href=\\\"https://www.employment.govt.nz/assets/uploads/documents/starting-employment/family-violence-leave-guide/rights-for-employees-affected-by-domestic-violence.pdf\\\" target=\\\"_blank\\\"\\u003eRights for employees affected by domestic violence\\u003c/a\\u003e)\\u003c/li\\u003e\\n\\u003cli\\u003edriver\u2019s licence (unless it is essential for the position).\\u003c/li\\u003e\\n\\u003c/ul\\u003e\\u003cp\\u003eThe Human Rights Commission has published a guide on many common pre-employment situations:\\u0026nbsp;\\u003ca title=\\\"Link to guide\\\" rel=\\\"noopener noreferrer\\\" href=\\\"/resources-and-support/guidelines/pre-employment-guidelines\\\" target=\\\"_blank\\\"\\u003eThe A - Z Pre-Employment Guide for employers and employees.\\u003c/a\\u003e\\u003c/p\\u003e\"},{\"attrId\":\"what-can-i-do-if-i-experience-racism-or-discrimination\",\"title\":\"What can I do if I experience racism or discrimination?\",\"description\":\"\\u003cp\\u003eYou can contact the Human Rights Commission for information and support.\\u003c/p\\u003e\\u003cp\\u003eSome kinds of racism are against the law. The Human Rights Act protects you from racial discrimination and racial harassment in certain areas of public life. These areas include employment, education, government services, access to housing and in the provision of goods and services.\\u003c/p\\u003e\\u003cp\\u003eRacial discrimination is where you are treated differently and less fairly than others because of your race, ethnicity or colour.\\u003c/p\\u003e\\u003cp\\u003eRacial harassment is hurtful or offensive language or behaviour of a racial nature that has a harmful effect on you. It can include offensive remarks or jokes about your race, mimicking the way you speak, or calling you names.\\u0026nbsp;\\u003c/p\\u003e\\u003cp\\u003eThe Commission can offer a dispute resolution process for these kinds of complaints. This involves a mediator helping people communicate with each other to resolve the complaint.\\u003c/p\\u003e\\u003cp\\u003eThe Human Rights Act does not cover racism you experience in your private life, such as on the street, from your neighbours, or in your personal relationships. However, regardless of where the racism happened, you can contact the Commission for information and support. Even if the racism isn\u2019t covered by the Human Rights Act, we may still be able to offer an alternative process or refer you to another agency who can help.\\u003c/p\\u003e\"},{\"attrId\":\"can-i-be-denied-access-because-i-have-a-disability-assist-dog\",\"title\":\"Can I be denied access to a motel or restaurant because I have a disability assist dog?\",\"description\":\"\\u003cp\\u003eNo. In New Zealand disability assist dogs have the right to access any public place and private business \u2013 including supermarkets, health facilities, shops and malls, food outlets, motels or hotels, movie theatres and restaurants. Disability assist dogs are entitled to travel on all forms of public transport, including in taxis. You may need permission to enter a marae or church.\\u003c/p\\u003e\\u003cp\\u003eDenying someone access because they rely on a disability assist dog may breach the Human Rights Act 1993. Disability assist dogs also have access rights under \\u003ca rel=\\\"noopener noreferrer\\\" href=\\\"https://www.legislation.govt.nz/act/public/1996/0013/latest/DLM375466.html\\\" target=\\\"_blank\\\"\\u003ethe Dog Control Act 1996\\u003c/a\\u003e.\\u003c/p\\u003e\\u003cp\\u003eIf you have been denied access due to your disability assist dog, you can contact us for information or to make a complaint.\\u003c/p\\u003e\"},{\"attrId\":\"can-a-landlord-specify-their-ideal-tenant\",\"title\":\"Can a landlord specify their ideal tenant?\",\"description\":\"\\u003cp\\u003eYes, a landlord can describe their ideal tenant, as long as that description doesn\u2019t show an intention to discriminate. The Human Rights Act makes it unlawful to advertise in a way that shows an intention to discriminate against potential tenants on any of the protected grounds. Landlords and agents should focus on their preferred qualities rather than on stereotypes. For example, they could say the ideal tenant is responsible, reliable and can provide references. They should avoid using terms like \u2018professional couple\u2019, as it could be seen to show an intention to discriminate against potential tenants because of their employment status or marital status.\\u003c/p\\u003e\"},{\"attrId\":\"are-maori-and-new-zealand-sign-language-official-languages-in-new-zealand\",\"title\":\"Are M\u0101ori and New Zealand Sign Language official languages in New Zealand?\",\"description\":\"\\u003cp\\u003e\\u003cspan\\u003eAlthough English is currently the most widely spoken language in New Zealand, M\u0101ori and New Zealand Sign Language both formally have special status under the law as official languages of New Zealand. For example, p\\u003c/span\\u003eeople have the right to speak M\u0101ori and New Zealand Sign Language in any legal proceedings.\\u0026nbsp;\\u003c/p\\u003e\"},{\"attrId\":\"can-my-employer-require-me-to-have-a-covid-19-vaccine\",\"title\":\"Can my employer require me to have a Covid-19 vaccine?\",\"description\":\"\\u003cp\\u003eSome employers may require their employees to be vaccinated if they consider they are at higher risk of catching and spreading COVID-19 at work than they would be in the community.\u202f This must be supported by a health and safety risk assessment for each role.\\u003c/p\\u003e\\u003cp\\u003e\\u003ca rel=\\\"noopener noreferrer\\\" href=\\\"https://www.worksafe.govt.nz/managing-health-and-safety/novel-coronavirus-covid/covid-19-controls-at-work/\\\" target=\\\"_blank\\\"\\u003eWorksafe\\u003c/a\\u003e\\u0026nbsp;has updated information and guidance on its website. Also see\\u0026nbsp;\\u003ca rel=\\\"noopener noreferrer\\\" href=\\\"https://www.employment.govt.nz/fair-work-practices/covid-19-in-the-workplace\\\" target=\\\"_blank\\\"\\u003eEmployment NZ\u2019s\\u003c/a\\u003e\\u0026nbsp;updated answers to frequently asked questions about vaccination and employment.\\u003c/p\\u003e\"}]}},{\"id\":19,\"blockType\":\"ElementRelatedPages\",\"data\":{\"content\":{\"title\":\"Popular pages\",\"showTitle\":true,\"description\":\"\"},\"cardItems\":[{\"title\":\"Make a complaint\",\"description\":\"Te K\u0101hui Tika Tangata Human Rights Commission provides free, confidential services for the public to deal with unlawful discrimination and prohibited behaviour under the Human Rights Act.\",\"link\":{\"label\":\"Make a complaint\",\"to\":\"/resources-and-support/make-a-complaint\",\"target\":\"\",\"anchor\":\"\",\"isInternal\":true}},{\"title\":\"What we do\",\"description\":\"Find out what the role of the Te K\u0101hui Tika Tangata Human Rights Commission is, how it operates and who we work with.\",\"link\":{\"label\":\"What we do\",\"to\":\"/about-us/what-we-do\",\"target\":\"\",\"anchor\":\"\",\"isInternal\":true}},{\"title\":\"Latest news\",\"description\":\"Find out about the latest work of Te\u00a0K\u0101hui\u00a0Tika\u00a0Tangata\u00a0Human Rights Commission .\",\"link\":{\"label\":\"News\",\"to\":\"/news\",\"target\":\"\",\"anchor\":\"\",\"isInternal\":true}}]}}],\"patterns\":[{\"xPosition\":\"right\",\"yPosition\":\"top\"},{\"xPosition\":\"right\",\"yPosition\":\"bottom\"}],\"hero\":{\"titleEnglish\":\"A life of dignity for all. \",\"titleMaori\":\"Ka whakamana t\u0101ngata\",\"descriptionEnglish\":\"How can we help?\",\"descriptionMaori\":\"Nau mai haere mai.\"}}},\"layoutData\":{\"success\":true,\"message\":\"\",\"status\":200,\"data\":{\"header\":[{\"subLabel\":\"About Us\",\"sort\":2,\"description\":\"Te K\u0101hui Tika Tangata Human Rights Commission is committed to a holistic expression of Te Tiriti o Waitangi and human rights including respectful relationships, shared responsibilities, and rights activation, and we aim to ensure te Tiriti o Waitangi is embedded in everything we do. Our purpose is he whakamana tangata, a life of dignity for all.\",\"link\":{\"label\":\"T\u014d T\u0101tou Wh\u0101nau\",\"to\":\"/about-us\",\"target\":\"\"},\"children\":[{\"link\":{\"label\":\"Our Story and Te Tiriti Journey\",\"to\":\"/about-us/our-te-tiriti-journey\",\"target\":\"\"},\"groupKey\":\"column-1\",\"children\":[]},{\"link\":{\"label\":\"Our People\",\"to\":\"/about-us/our-people\",\"target\":\"\"},\"groupKey\":\"column-1\",\"children\":[]},{\"link\":{\"label\":\"What We Do\",\"to\":\"/about-us/what-we-do\",\"target\":\"\"},\"groupKey\":\"column-1\",\"children\":[]},{\"link\":{\"label\":\"The Office of Human Rights Proceedings\",\"to\":\"/about-us/office-of-human-rights-proceedings\",\"target\":\"\"},\"groupKey\":\"column-2\",\"children\":[]},{\"link\":{\"label\":\"Corporate publications\",\"to\":\"/about-us/corporate-publications\",\"target\":\"\"},\"groupKey\":\"column-2\",\"children\":[]},{\"link\":{\"label\":\"How we can help\",\"to\":\"/about-us/how-we-can-help\",\"target\":\"\"},\"groupKey\":\"column-1\",\"children\":[]},{\"link\":{\"label\":\"Careers\",\"to\":\"https://mahi.hrc.co.nz/\",\"target\":\"_blank\"},\"groupKey\":\"column-2\",\"children\":[]}]},{\"subLabel\":\"Our Work\",\"sort\":3,\"description\":\"Te K\u0101hui Tika Tangata Human Rights Commission works to create continuous meaningful improvement in the realisation of human rights for all people in Aotearoa New Zealand through our projects, campaigns and publications. We work to make te Tiriti and human rights real and relevant within and outside the organisation and make a positive impact for all individuals, wh\u0101nau, hap\u016b, communities and iwi in Aotearoa.\",\"link\":{\"label\":\"\u0100 T\u0101tou Kaupapa\",\"to\":\"/our-work\",\"target\":\"\"},\"children\":[{\"link\":{\"label\":\"Case Studies\",\"to\":\"/our-work/case-studies\",\"target\":\"\"},\"groupKey\":\"\",\"children\":[]},{\"link\":{\"label\":\"Projects\",\"to\":\"https://tikatangata.org.nz/our-work?type=project\",\"target\":\"_blank\"},\"groupKey\":\"\",\"children\":[]},{\"link\":{\"label\":\"Publications\",\"to\":\"https://tikatangata.org.nz/our-work?type=publication\",\"target\":\"_blank\"},\"groupKey\":\"\",\"children\":[]},{\"link\":{\"label\":\"Campaigns\",\"to\":\"https://tikatangata.org.nz/our-work?type=campaign\",\"target\":\"_blank\"},\"groupKey\":\"\",\"children\":[]}]},{\"subLabel\":\"Human Rights in Aotearoa\",\"sort\":4,\"description\":\"Human rights are the basic rights and freedoms that everyone has in Aotearoa New Zealand. There are two main types of human rights \u2013 civil and political rights, and social, cultural and economic rights.\",\"link\":{\"label\":\"Mana Tangata\",\"to\":\"/human-rights-in-aotearoa\",\"target\":\"\"},\"children\":[{\"link\":{\"label\":\" What are human rights?\",\"to\":\"/human-rights-in-aotearoa/what-are-human-rights\",\"target\":\"\