gs-wrap {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 40px 22px;\n    font-family: 'Open Sans', sans-serif;\n    font-size: 17px;\n    line-height: 1.65;\n    color: #222222;\n  }\n\n  .fivethings-eyebrow {\n    text-transform: uppercase;\n    letter-spacing: .14em;\n    font-weight: 700;\n    font-size: .76rem;\n    color: #555559;\n    margin: 0 0 .4rem;\n  }\n\n  .fivethings-heading {\n    font-size: clamp(1.45rem, 3vw, 2rem);\n    font-weight: 800;\n    margin: 0 0 .5em;\n    line-height: 1.2;\n    color: #111;\n  }\n\n  .fivethings-intro {\n    margin: 0 0 1rem;\n  }\n\n  .fivethings { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-top: 12px; }\n\n  .ft .block  { border-radius: 4px; min-height: 92px; display: flex; align-items: center; justify-content: center; }\n  .ft .num    { font-size: 2.4rem; font-weight: 800; line-height: 1; }\n  .ft .ft-title { margin: .7em 0 .35em; font-size: 1.12rem; font-weight: 800; color: #111; line-height: 1.2; }\n  .ft .ft-body  { margin: 0; font-size: .94rem; }\n\n  .ft.c1 .block { background: #ffd522; } .ft.c1 .num { color: #111; }\n  .ft.c2 .block { background: #0089b1; } .ft.c2 .num { color: #fff; }\n  .ft.c3 .block { background: #23ae49; } .ft.c3 .num { color: #fff; }\n  .ft.c4 .block { background: #e81d2e; } .ft.c4 .num { color: #fff; }\n  .ft.c5 .block { background: #555559; } .ft.c5 .num { color: #fff; }\n\n  @media (max-width: 1000px) { .fivethings { grid-template-columns: repeat(2, 1fr); } }\n  @media (max-width: 560px)  { .fivethings { grid-template-columns: 1fr; } }</style><meta name=\"Generator\" content=\"Sitefinity 14.4.8152.0 DX\" /><link rel=\"canonical\" href=\"https://www.waikatodistrict.govt.nz/subscribe-to-waikato-district-news\" /><script type=\"application/json\" id=\"sf-insight-metadata\">\r\n\t{\"contentMetadata\":\"{\\\"Id\\\":\\\"eddbe83e-36f3-61b3-b84d-ff0000681c44\\\",\\\"ContentType\\\":\\\"Page\\\",\\\"Title\\\":\\\"Subscribe to Waikato District News\\\",\\\"Ca