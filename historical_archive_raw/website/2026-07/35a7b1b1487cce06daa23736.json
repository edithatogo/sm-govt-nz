e-embedded-code__container\">\n            <div class=\"u-gutter\">\n                \n\n                \n                    <div class=\"e-embedded-code__wrapper\">        \n                        <div class=\"u-content\"><p>By subscribing to our mailing list, you can stay informed about the work of the Commission and ensure your voice is heard when we consult on our law reform reviews.</p>\n<p><b>Note:</b> This form is for subscribing to our newsletters and general updates. If you are a media outlet or journalist and would like to be added to the Commission\u2019s media list, please use our <a href=\"https://www.lawcom.govt.nz/about-us/contact-us\">contact form</a> or email us at <a href=\"mailto:com@lawcom.govt.nz\">com@lawcom.govt.nz</a>.</p>\n</div>\n\n<div id=\"mc_embed_shell\">\n      <link href=\"//cdn-images.mailchimp.com/embedcode/classic-061523.css\" rel=\"stylesheet\" type=\"text/css\">\n  \n<div id=\"mc_embed_signup\">\n    <form action=\"https://govt.us14.list-manage.com/subscribe/post?u=da8a96d3158de65ddbbf589c3&amp;id=8b1ef777b0&amp;f_id=00c6ffe0f0\" method=\"post\" id=\"mc-embedded-subscribe-form\" name=\"mc-embedded-subscribe-form\" class=\"validate\" target=\"_self\" novalidate=\"\">\n        <div id=\"mc_embed_signup_scroll\">\n            <div class=\"indicates-required\"><span class=\"asterisk\">*</span> indicates required</div>\n            <div class=\"mc-field-group\"><label for=\"mce-EMAIL\">Email Address <span class=\"asterisk\">*</span></label><input type=\"email\" name=\"EMAIL\" class=\"required email\" id=\"mce-EMAIL\" required=\"\" value=\"\"></div><div class=\"mc-field-group\"><label for=\"mce-FNAME\">First Name <span class=\"asterisk\">*</span></label><input type=\"text\" name=\"FNAME\" class=\"required text\" id=\"mce-FNAME\" value=\"\" required=\"\"></div><div class=\"mc-field-group\"><label for=\"mce-LNAME\">Last Name <span class=\"asterisk\">*</span></label><input type=\"text\" name=\"LNAME\" class=\"required text\" id=\"mce-LNAME\" value=\"\" required=\"\"></div><div class=\"mc-field-group\"><label for=\"mce-MMERGE5\">Organisation </label><input type=\"text\" name=\"MMERGE5\" class=\" text\" id=\"mce-MMERGE5\" value=\"\"></div>\n<div hidden=\"\"><input type=\"hidden\" name=\"tags\" value=\"40188725\"></div>\n        <div id=\"mce-responses\" class=\"clear\">\n            <div class=\"response\" id=\"mce-error-response\" style=\"display: none;\"></div>\n            <div class=\"response\" id=\"mce-success-response\" style=\"display: none;\"></div>\n        </div><div aria-hidden=\"true\" style=\"position: absolute; left: -5000px;\"><input type=\"text\" name=\"b_da8a96d3158de65ddbbf589c3_8b1ef777b0\" tabindex=\"-1\" value=\"\"></div><div class=\"clear\"><input type=\"submit\" name=\"subscribe\" id=\"mc-embedded-subscribe\" class=\"button\" value=\"Subscribe\"></div>\n    </div>\n</form>\n</div>\n</div>\n\n                    </div>\n                \n            </div>\n        </div>\n    </div>\n</div>\n</div>\n\n    \n\n\n        </div>\n    </div>\n</main>\n\t\t\n\t\t\t\r\n\t<footer id=\"global-footer\" class=\"c-footer\">\r\n\t\t<div class=\"u-container u-container--extra-wide\">\r\n\t\t\t<div class=\"c-footer__wrapper u-container\">\r\n\r\n\t\t\t\t<div class=\"c-footer__cell c-footer__cell--logo\">\r\n\r\n\t\t\t\t\t<a title=\"Go to homepage\" class=\"c-footer__logo\" href=\"/\"><img src=\"/assets/Uploads/law-commission-logo-white__ScaleMaxWidthWzI2MF0_ExtRewriteWyJwbmciLCJ3ZWJwIl0.webp\" alt=\"Law Commission logo - white\" width=\"260\" height=\"105\" /></a>\r\n\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"c-footer__cell c-footer__cell--social\">\r\n\t\t\t\t\t<div class=\"c-footer__social-links\">\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t<a href=\"https://www.facebook.com/nzlawcommission/\" target=\"_blank\" class=\"c-footer__social footer__social--Facebook\" title=\"Go to our Facebook page\"><span class=\"icon svg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"30\" height=\"30\" viewBox=