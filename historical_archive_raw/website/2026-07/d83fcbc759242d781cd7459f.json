\" data-bs-toggle=\"collapse\" data-bs-target=\"#navigation-submenu-196\" aria-expanded=\"false\" aria-controls=\"navigation-submenu-196\">\n              <span class=\"visually-hidden\">Show submenu for Contact Us</span>\n            </button>\n\n            <ul id=\"navigation-submenu-196\" class=\"navigation-submenu collapse\" data-parent=\"#main-navigation\">\n              \n                <li class=\"navigation-item\">\n\n                  <a class=\"navigation-link link\" href=\"/contact-us/reporting-a-national-security-concern\">\n                    \n                    <span class=\"english\" lang=\"en\">Reporting a national security concern</span>\n                  </a>\n\n                </li>\n              \n                <li class=\"navigation-item\">\n\n                  <a class=\"navigation-link link\" href=\"/contact-us/talking-with-us\">\n                    \n                    <span class=\"english\" lang=\"en\">Talking with us</span>\n                  </a>\n\n                </li>\n              \n            </ul>\n          </li>\n        \n      \n    </ul>\n  </nav>\n</div>\n\n    </div>\n    \n\n  </div>\n</header>\n\n    <div class=\"fade-overlay\"></div>\n    <main role=\"main\">\n      <div class=\"page-banner\">\n  <div class=\"container\">\n    <div class=\"page-banner-inner\">\n      \n      <h1 class=\"page-banner-title\">News</h1>\n      \n      <p class=\"page-banner-content\">\n      Our media releases and copies of speeches by the Director-General of Security. \n      </p>\n      \n    </div>\n  </div>\n</div>\n\n<div class=\"container container-news-page\">\n  <div class=\"page\">\n    <div class=\"row\">\n      <div class=\"col-lg-9\">\n        <div class=\"content\">\n\n          \n    \n\t   <div class=\"element-column-holder has-background-colour\" id=\"#eaf7fa\" style=\"background-color:#eff5ef\">\n  <div class=\"element-container element-column\">\n    \n    <div class=\"row\">\n      \n\n  \n  <div class=\"col-lg-12 col-md-12\">\n    <div class=\"hero-content content hero-content-padding\">\n      <p>Sign up to receive a <strong>news alert</strong>&nbsp;<span>when news is published to this website.</span></p>\n      \n        <a class=\"hero-button\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"external\" href=\"https://confirmsubscription.com/h/y/F8B98CE79B3BA0F6\" title=\"\" style=\"color: ; \">Subscribe</a>\n      \n    </div>\n  </div>\n  \n\n\n\n    </div>\n  </div>\n</div>\n\n    \n\n\n          \n            \n         <ul class=\"news\">\n            \n                \n<li class=\"news-item \">\n\n  \n\n  <a class=\"news-item-link\" href=\"/news/joint-five-eyes-bulletin-safeguarding-our-secrets\" title=\"Read more about 'Joint Five Eyes Bulletin \u2013 Safeguarding our Secrets'...\">\n    <h2 class=\"news-item-heading\">\n    \n      Joint Five Eyes Bulletin \u2013 Safeguarding our Secrets\n    \n    </h2>\n  </a>\n\n  <ul class=\"news-item-details list-inline\">\n    <li class=\"news-detail-item news-detail-item-date\">\n      Posted\n      <span class=\"news-item-date\" href=\"/news/archive/2026/6/4\">June 04, 2026</span>\n    </li>\n    \n      <li class=\"news-detail-item\">\n        <a class=\"news-item-tag\" href=\"/news/category/media-releases\">Media Releases</a>\n      </li>\n    \n  </ul>\n\n  \n    \n    <p>The New Zealand Security Intelligence Service (NZSIS) has joined Five Eyes partners to highlight increased targeting of professional networking sites and online job platforms for intelligence purposes by China\u2019s military intelligence services.</p>\n    \n  \n  <a class=\"news-item-readmore-link\" href=\"/news/joint-five-eyes-bulletin-safeguarding-our-secrets\" title=\"Read more about 'Joint Five Eyes Bulletin \u2013 Safeguarding our Secrets'...\">Read more</a>\n</li>\n\n            \n                \n<li class=\"news-item \">\n\n  \n\n  <a class=\"news-item-link\" href=\"/news/statement-to-the-intelligence-and-security-committee-by-director-general-andrew-hampton-4-march-2026\" title=\"Read more about 'Statement to the Intelligence and Security Committee by Director-General Andrew Hampton 4 March 2026'...\">\n    <h2 class=\"news-item-heading\">\n    \n      Statement to the Intelligence and Security Committee by Director-General Andrew Hampton 4 March 2026\n    \n    </h2>\n  </a>\n\n  <ul class=\"news-item-details list-inline\">\n    <li class=\"news-detail-item news-detail-item-date\">\n      Posted\n      <span class=\"news-item-date\" href=\"/news/archive/2026/3/4\">March 04, 2026</span>\n    </li>\n    \n      <li class=\"news-detail-item\">\n        <a class=\"news-item-tag\" href=\"/news/category/director-general-speeches\">Director-General Speeches</a>\n      </li>\n    \n  </ul>\n\n  \n    \n    <p>Wednesday 4 March, 2026 T\u0113n\u0101 koutou katoa Thank you for the opportunity to address you today.</p>\n    \n  \n  <a class=\"news-item-readmore-link\" href=\"/news/statement-to-the-intelligence-and-security-committee-by-director-general-andrew-hampton-4-march-2026\" title=\"Read more about 'Statement to the Intelligence and Security Committee by Director-General Andrew Hampton 4 March 2026'...\">Read more</a>\n</li>\n\n            \n                \n<li class=\"news-item \">\n\n  \n\n  <a class=\"news-item-link\" href=\"/news/national-terrorism-threat-level-unchanged-but-described-as-possible-under-updated-language\" title=\"Read more about 'National Terrorism Threat Level unchanged but described as POSSIBLE under updated language '...\">\n    <h2 class=\"news-item-heading\">\n    \n      National Terrorism Threat Level unchanged but described as POSSIBLE under updated language \n    \n    </h2>\n  </a>\n\n  <ul class=\"news-item-details list-inline\">\n    <li class=\"news-detail-item news-detail-item-date\">\n      Posted\n      <span class=\"news-item-date\" href=\"/news/archive/2026/2/24\">February 24, 2026</span>\n    </li>\n    \n      <li class=\"news-detail-item\">\n        <a class=\"news-item-tag\" href=\"/news/category/media-releases\">Media Releases</a>\n      </li>\n    \n  </ul>\n\n  \n    \n    <p>New Zealand\u2019s National Terrorism Threat Level (terrorism threat level) remains unchanged following an annual review by the Combined Threat Assessment Group (CTAG), an inter-agency group hosted and led by the New Zealand Security Intelligence Service (NZSIS).</p>\n    \n  \n  <a class=\"news-item-readmore-link\" href=\"/news/national-terrorism-threat-level-unchanged-but-described-as-possible-under-updated-language\" title=\"Read more about 'National Terrorism Threat Level unchanged but described as POSSIBLE under updated language '...\">Read more</a>\n</li>\n\n            \n                \n<li class=\"news-item \">\n\n  \n\n  <a class=\"news-item-link\" href=\"/news/speech-to-dunstan-high-school\" title=\"Read more about 'Speech to Dunstan High School'...\">\n    <h2 class=\"news-item-heading\">\n    \n      Speech to Dunstan High School\n    \n    </h2>\n  </a>\n\n  <ul class=\"news-item-details list-inline\">\n    <li class=\"news-detail-item news-detail-item-date\">\n      Posted\n      <span class=\"news-item-date\" href=\"/news/archive/2025/10/20\">October 20, 2025</span>\n    </li>\n    \n      <li class=\"news-detail-item\">\n        <a class=\"news-item-tag\" href=\"/news/category/director-general-speeches\">Director-General Speeches</a>\n      </li>\n    \n  </ul>\n\n  \n    <p>Dunstan High School \u2013 Assembly speech by Director-General Andrew Hampton, Friday 10 October 2025.</p>\n  \n  <a class=\"news-item-readmore-link\" href=\"/news/speech-to-dunstan-high-school\" title=\"Read more about 'Speech to Dunstan High School'...\">Read more</a>\n</li>\n\n            \n                \n<li class=\"news-item \">\n\n  \n\n  <a class=\"news-item-link\" href=\"/news/speech-to-the-aspen-otago-national-security-forum\" title=\"Read more about 'Speech to the Aspen - Otago National Security Forum'...\">\n    <h2 class=\"news-item-heading\">\n    \n      Speech to the Aspen - Otago National Security Forum\n    \n    </h2>\n  </a>\n\n  <ul class=\"news-item-details list-inline\">\n    <li class=\"news-detail-item news-detail-item-date\">\n      Posted\n      <span class=\"news-item-date\" href=\"/news/archive/2025/10/17\">October 17, 2025</span>\n    </li>\n    \n      <li class=\"news-detail-item\">\n        <a class=\"news-item-tag\" href=\"/news/category/director-general-speeches\">Director-General Speeches</a>\n      </li>\n    \n  </ul>\n\n  \n    \n    <p>Aspen \u2013 Otago National Security Forum Australian-New Zealand National Security: Shared Threats, Shared Solutions Open Session: The public-private security partnership Address by Andrew Hampton, Director-General of Security Saturday 11 October 2025 Thank you for the opportunity to speak with you today.</p>\n    \n  \n  <a class=\"news-item-readmore-link\" href=\"/news/speech-to-the-aspen-otago-national-security-forum\" title=\"Read more about 'Speech to the Aspen - Otago National Security Forum'...\">Read more</a>\n</li>\n\n            \n                \n<li class=\"news-item \">\n\n  \n\n  <a class=\"news-item-link\" href=\"/news/2025-nzsis-security-threat-environment-report\" title=\"Read more about '2025 NZSIS Security Threat Environment report'...\">\n    <h2 class=\"news-item-heading\">\n    \n      2025 NZSIS Security Threat Environment report\n    \n    </h2>\n  </a>\n\n  <ul class=\"news-item-details list-inline\">\n    <li class=\"news-detail-item news-detail-item-date\">\n      Posted\n      <span class=\"news-item-date\" href=\"/news/archive/2025/8/21\">August 21, 2025</span>\n    </li>\n    \n      <li class=\"news-detail-item\">\n        <a class=\"news-item-tag\" href=\"/news/category/media-releases\">Media Releases</a>\n      </li>\n    \n  </ul>\n\n  \n    <p>The New Zealand Security Intelligence Service has warned the country is facing one of the most challenging national security environments in recent times.</p>\n  \n  <a class=\"news-item-readmore-link\" href=\"/news/2025-nzsis-security-threat-environment-report\" title=\"Read more about '2025 NZSIS Security Threat Environment report'...\">Read more</a>\n</li>\n\n            \n                \n<li class=\"news-item \">\n\n  \n\n  <a class=\"news-item-link\" href=\"/news/nzsis-releases-historical-records-on-russian-kgb-agent-and-the-communist-party-of-new-zealand\" title=\"Read more about 'NZSIS releases historical records on Russian KGB agent and the Communist Party of New Zealand'...\">\n    <h2 class=\"news-item-heading\">\n    \n      NZSIS releases historical records on Russian KGB agent and the Communist Party of New Zealand\n    \n    </h2>\n  </a>\n\n  <ul class=\"news-item-details list-inline\">\n    <li class=\"news-detail-item news-detail-item-date\">\n      Posted\n      <span class=\"news-item-date\" href=\"/news/archive/2025/5/9\">May 09, 2025</span>\n    </li>\n    \n      <li class=\"news-detail-item\">\n        <a class=\"news-item-tag\" href=\"/news/category/media-releases\">Media Releases</a>\n      </li>\n    \n  </ul>\n\n  \n    <p>The New Zealand Security Intelligence Service (NZSIS) has released declassified Cold War-era records about a Russian KGB agent operating in Wellington, as well as historical records about the activities of the Communist Party of New Zealand.</p>\n  \n  <a class=\"news-item-readmore-link\" href=\"/news/nzsis-releases-historical-records-on-russian-kgb-agent-and-the-communist-party-of-new-zealand\" title=\"Read more about 'NZSIS releases historical records on Russian KGB agent and the Communist Party of New Zealand'...\">Read more</a>\n</li>\n\n            \n                \n<li class=\"news-item \">\n\n  \n\n  <a class=\"news-item-link\" href=\"/news/the-importance-of-intelligence-cooperation-with-the-pacific\" title=\"Read more about 'The importance of intelligence cooperation with the Pacific'...\">\n    <h2 class=\"news-item-heading\">\n    \n      The importance of intelligence cooperation with the Pacific\n    \n    </h2>\n  </a>\n\n  <ul class=\"news-item-details list-inline\">\n    <li class=\"news-detail-item news-detail-item-date\">\n      Posted\n      <span class=\"news-item-date\" href=\"/news/archive/2025/3/7\">March 07, 2025</span>\n    </li>\n    \n      <li class=\"news-detail-item\">\n        <a class=\"news-item-tag\" href=\"/news/category/director-general-speeches\">Director-General Speeches</a>\n      </li>\n    \n  </ul>\n\n  \n    <p>An address by NZSIS Director-General of Security Andrew Hampton to the New Zealand Institute of International Affairs, Wellington, 6 March 2025</p>\n  \n  <a class=\"news-item-readmore-link\" href=\"/news/the-importance-of-intelligence-cooperation-with-the-pacific\" title=\"Read more about 'The importance of intelligence cooperation with the Pacific'...\">Read more</a>\n</li>\n\n            \n                \n<li class=\"news-item \">\n\n  \n\n  <a class=\"news-item-link\" href=\"/news/opening-statement-to-the-intelligence-and-security-committee-19-february-2025\" title=\"Read more about 'Statement to the Intelligence and Security Committee by Director-General Andrew Hampton 19 February 2025'...\">\n    <h2 class=\"news-item-heading\">\n    \n      Statement to the Intelligence and Security Committee by Director-General Andrew Hampton 19 February 2025\n    \n    </h2>\n  </a>\n\n  <ul class=\"news-item-details list-inline\">\n    <li class=\"news-detail-item news-detail-item-date\">\n      Posted\n      <span class=\"news-item-date\" href=\"/news/archive/2025/2/20\">February 20, 2025</span>\n    </li>\n    \n      <li class=\"news-detail-item\">\n        <a class=\"news-item-tag\" href=\"/news/category/director-general-speeches\">Director-General Speeches</a>\n      </li>\n    \n  </ul>\n\n  \n    \n    <p>Wednesday 19 February, 2025 &amp;nbsp; Kia ora koutou Thank you for the opportunity to address you today.</p>\n    \n  \n  <a class=\"news-item-readmore-link\" href=\"/news/opening-statement-to-the-intelligence-and-security-committee-19-february-2025\" title=\"Read more about 'Statement to the Intelligence and Security Committee by Director-General Andrew Hampton 19 February 2025'...\">Read more</a>\n</li>\n\n            \n                \n<li class=\"news-item \">\n\n  \n\n  <a class=\"news-item-link\" href=\"/news/scam-email-circulating-using-the-treasury-and-nzsis-logos\" title=\"Read more about 'Scam email circulating using The Treasury and NZSIS logos'...\">\n    <h2 class=\"news-item-heading\">\n    \n      Scam email circulating using The Treasury and NZSIS logos\n    \n    </h2>\n  </a>\n\n  <ul class=\"news-item-details list-inline\">\n    <li class=\"news-detail-item news-detail-item-date\">\n      Posted\n      <span class=\"news-item-date\" href=\"/news/archive/2024/12/20\">December 20, 2024</span>\n    </li>\n    \n      <li class=\"news-detail-item\">\n        <a class=\"news-item-tag\" href=\"/news/category/media-releases\">Media Releases</a>\n      </li>\n    \n  </ul>\n\n  \n    <p>NZSIS is aware of a scam letter circulating via email claiming to be from The Treasury, which also uses the NZSIS logo.&nbsp;</p>\n  \n  <a class=\"news-item-readmore-link\" href=\"/news/scam-email-circulating-using-the-treasury-and-nzsis-logos\" title=\"Read more about 'Scam email circulating using The Treasury and NZSIS logos'...\">Read more</a>\n</li>\n\n            \n        </ul>\n\n          \n\n          \n            \n                \n\n<nav class=\"pagination-custom-holder aria-label=\"news pagination\">\n    <ul class=\"pagination-custom content\">\n\t\t\n\n\t\t\n\t\t\t\n\t\t\t\t<li class=\"pagination-item disabled\"><a class=\"pagination-link\" href=\"/news?url=news#\" aria-disabled=\"true\" tabindex=\"-1\">1</a></li>\n\t\t\t\n\t\t\n\t\t\t\n\t\t\t\t\n\t\t\t\t\t<li class=\"pagination-item\"><a class=\"pagination-link\" href=\"/news?url=news&amp;start=10\">2</a></li>\n\t\t\t\t\n\t\t\t\n\t\t\n\t\t\t\n\t\t\t\t\n\t\t\t\t\t<li class=\"paginati