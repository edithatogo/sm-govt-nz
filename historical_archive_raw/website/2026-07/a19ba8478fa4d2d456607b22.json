cript><script data-bundle=\"plone\" integrity=\"sha384-T7C7Yovbvi1N4mUURIMkSdCYiheVGEeinkE0BbENGVeMKaPPPcwZk3djZfMKOEq/\" src=\"https://ao.parliament.nz/++webresource++34f34eab-a19d-533e-a464-ddf672c6f922/++plone++static/bundle-plone/bundle.min.js\"></script><script data-bundle=\"oag2025-theme\" integrity=\"sha384-RFioKVhF93/Wc4lYtNvnYhZm1QFB5VDRqf+RkECN8AiWqhFeF8s+gKLebN0rNQDM\" src=\"https://ao.parliament.nz/++webresource++4ec678d5-e8df-5af3-9131-2c9ce67fb8ff/++theme++oag2025/js/main.min.js\"></script><script data-bundle=\"anonymouseditpatterns-bundle\" integrity=\"sha384-t/+eJK7azAhUOa8bSlFa63qy/k6RCBruxOq+K4lkfhN2RZA01KAMgHnOq1hI9Dxq\" src=\"https://ao.parliament.nz/++webresource++c67c6974-93c8-5220-8c18-dace600c33ac/++plone++collective.anonymouseditpatterns/anonymouseditpatterns-compiled.min.js\"></script></head>\n\n  <body class=\"d-flex flex-column h-100 col-content frontend icons-off no-portlet-columns portaltype-document section-home site-oag template-document_view thumbs-off userrole-anonymous viewpermission-view\" id=\"visual-portal-wrapper\" dir=\"ltr\" data-base-url=\"https://ao.parliament.nz/home\" data-view-url=\"https://ao.parliament.nz/home\" data-portal-url=\"https://ao.parliament.nz\" data-i18ncatalogurl=\"https://ao.parliament.nz/plonejsi18n\" data-pat-pickadate=\"{&quot;date&quot;: {&quot;selectYears&quot;: 200}, &quot;time&quot;: {&quot;interval&quot;: 5 } }\" data-pat-plone-modal=\"{&quot;actionOptions&quot;: {&quot;displayInModal&quot;: false}}\"><div class=\"outer-wrapper flex-shrink-0\">\n      <header class=\"container d-flex flex-column justify-content-between align-items-lg-start flex-lg-row\" id=\"content-header\">\n\n        <div class=\"d-flex justify-content-end\" id=\"portal-top\">\n        \n\n\n\n\n\n\n\n      </div>\n\n        <div class=\"d-flex justify-content-between align-items-center order-lg-first w-auto\" id=\"portal-logo-wrapper\">\n          <a id=\"portal-logo\" title=\"The Audit Office\" href=\"https://ao.parliament.nz\">\n  <img alt=\"The Audit Office\" src=\"https://ao.parliament.nz/@@site-logo/ao_logo.svg\" title=\"The Audit Office\" /></a>\n          <div class=\"navbar navbar-expand-lg\">\n            <button class=\"navbar-toggler border-secondary\" aria-controls=\"offcanvasNavbar\" type=\"button\" data-bs-target=\"#offcanvasNavbar\" data-bs-toggle=\"offcanvas\" aria-label=\"Toggle navigation\">\n              <span class=\"navbar-toggler-icon\"></span>\n            </button>\n          </div>\n        </div>\n\n      </header>\n\n      <div id=\"mainnavigation-wrapper\">\n        <div id=\"mainnavigation\">\n          <nav class=\"navbar navbar-expand-lg navbar-barceloneta pat-navigationmarker\" id=\"portal-globalnav-wrapper\">\n            <div class=\"container\">\n              <div class=\"offcanvas offcanvas-end\" id=\"offcanvasNavbar\" aria-labelledby=\"offcanvasNavbarLabel\" tabindex=\"-1\">\n                <div class=\"offcanvas-header justify-content-end\">\n                  <button class=\"btn-close btn-close-white text-reset\" aria-label=\"Close\" type=\"button\" data-bs-dismiss=\"offcanvas\"></button>\n                </div>\n                <div class=\"offcanvas-body align-items-center\">\n                  <ul class=\"navbar-nav me-auto\" id=\"portal-globalnav\">\n    <li class=\"about-us nav-item\"><a href=\"https://ao.parliament.nz/about-us\" class=\"state-published nav-link\">About us</a></li><li class=\"annual-audits nav-item\"><a href=\"https://ao.parliament.nz/annual-audits\" class=\"state-published nav-link\">Annual audits</a></li><li class=\"resources nav-item\"><a href=\"https://ao.parliament.nz/resources\" class=\"state-published nav-link\">Resources</a></li><li class=\"work-programme nav-item\"><a href=\"https://ao.parliament.nz/work-programme\" class=\"state-published nav-link\">Work programme</a></li>\n  </ul>\n                  <div class=\"d-flex flex-column position-relative\" id=\"portal-searchbox\">\n\n  <form class=\"d-flex pat-livesearch show_images\" id=\"searchGadget_form\" action=\"https://ao.parliament.nz/@@search\" role=\"search\" data-pat-livesearch=\"ajaxUrl:https://ao.parliament.nz/@@ajax-search\">\n\n    <input name=\"oagSearchReturn\" type=\"hidden\" value=\"Home\" />\n\n    <label class=\"hiddenStructure\" for=\"searchGadget\">Search Site</label>\n\n    <input class=\"searchField form-control me-2\" id=\"searchGadget\" name=\"SearchableText\" placeholder=\"Search Site\" size=\"18\" title=\"Search Site\" type=\"text\" />\n\n    <button class=\"searchButton btn btn-outline-light\" type=\"submit\">Search</button>\n\n    <div class=\"hiddenStructure\" id=\"portal-advanced-search\">\n      <a href=\"https://ao.parliament.nz/@@search\">Advanced Search\u2026</a>\n    </div>\n\n  </form>\n\n</div>\n                </div>\n              </div>\n            </div>\n          </nav>\n        </div>\n      </div>\n\n      <div id=\"hero\"><section class=\"section-leadimage text-center\">\n    <img class=\"d-block img-fluid w-100 mb-4\" src=\"https://ao.parliament.nz/home/@@images/image\" />\n    \n  </section></div>\n\n      \n\n      <div class=\"container\">\n        <div class=\"row\">\n          <aside class=\"col-12\" id=\"global_statusmessage\">\n      \n\n      <div>\n      </div>\n    </aside>\n        </div>\n        <main class=\"row\" id=\"main-container\">\n          <section id=\"portal-column-content\">\n\n      \n\n      \n\n        \n\n          <article id=\"content\">\n\n            \n\n              <header>\n\n                <div id=\"viewlet-above-content-title\"><span id=\"social-tags-body\" itemscope=\"\" itemtype=\"http://schema.org/WebPage\" style=\"display: none\">\n  <span itemprop=\"name\">Home</span>\n  <span itemprop=\"description\"></span>\n  <span itemprop=\"url\">https://ao.parliament.nz</span>\n  <span itemprop=\"image\">https://ao.parliament.nz/home/@@images/image-1200-4cf712e9c379bc24f43e20d16868039b.jpeg</span>\n</span>\n\n\n  <!-- Hero-style lead image for Pages -->\n  \n\n  <!-- Floated thumbnail lead image for News Items and other types -->\n  \n\n</div>\n\n                \n                  <h1>Home</h1>\n\n                \n\n                <div id=\"viewlet-below-content-title\">\n</div>\n\n                \n                  \n\n                \n\n                <div id=\"viewlet-below-content-description\"></div>\n\n              </header>\n\n              <div id=\"viewlet-above-content-body\">\n\n\n\n\n\n\n\n</div>\n\n              <div id=\"content-core\">\n                \n      \n\n        <section id=\"section-text\">\n          <div class=\"\" id=\"parent-fieldname-text\"><h2>News and updates</h2>\n<div class=\"row row-cols-1 row-cols-md-3 mb-3 g-3\">\n<div class=\"col\">\n<div class=\"card h-100\"><picture><source srcset=\"https://ao.parliament.nz/gfx/sunrise-pattern-3.png/@@images/image-1000-f096735f39b2694b5862563dcf4039e7.png 1000w,https://ao.parliament.nz/gfx/sunrise-pattern-3.png/@@images/image-400-71505f0f67c1208047a1543e0dc5f972.png 400w,https://ao.parliament.nz/gfx/sunrise-pattern-3.png/@@images/image-600-1f86595e13ef58ea4aa27cf7e4dace12.png 600w,https://ao.parliament.nz/gfx/sunrise-pattern-3.png/@@images/image-800-0540e65743184d303eab8b968ab20b99.png 800w,https://ao.parliament.nz/gfx/sunrise-pattern-3.png/@@images/image-1200-393250716a0b4c13d2bb72c6bd647199.png 1200w,https://ao.parliament.nz/gfx/sunrise-pattern-3.png/@@images/image-1600-1ef13786ab096716aedf41369f8535e7.png 1600w\"></source><img alt=\"...\" class=\"card-img-top\" height=\"281\" loading=\"lazy\" src=\"https://ao.parliament.nz/gfx/sunrise-pattern-3.png/@@images/image-1000-f096735f39b2694b5862563dcf4039e7.png\" title=\"corporate image\" width=\"500\" /></picture>\n<div class=\"card-body\">\n<h4 class=\"card-title\"><a href=\"https://ao.parliament.nz/2026/city-link-bridge/index.htm\" title=\"Management of conflicts of interest relating to the City Link bridge\">Management of conflicts of interest relating to the City Link bridge</a></h4>\n<p>We have written to the Minister of Housing (Hon Chris Bishop) and the Cabinet Office about how the Minister\u2019s constituency interests were managed in decisions to fund the City Link bridge in Lower Hutt.</p>\n<a class=\"btn btn-primary\" href=\"https://ao.parliament.nz/2026/city-link-bridge/index.htm\" title=\"Management of conflicts of interest relating to the City Link bridge\">Read more</a></div>\n</div>\n</div>\n<div class=\"col\">\n<div class=\"card h-100\"><picture><source srcset=\"https://ao.parliament.nz/gfx/4-education-c-kathryn-taylor-truestock.jpg/@@images/image-1000-26f823057d364cf8b7ce4efad4f895e1.jpeg 1000w,https://ao.parliament.nz/gfx/4-education-c-kathryn-taylor-truestock.jpg/@@images/image-400-889a33056848dbcb0d267e38c408f7a1.jpeg 400w,https://ao.parliament.nz/gfx/4-education-c-kathryn-taylor-truestock.jpg/@@images/image-600-cb43802a90bde0048d9253f86ae4c855.jpeg 600w,https://ao.parliament.nz/gfx/4-education-c-kathryn-taylor-truestock.jpg/@@images/image-800-99f93bb6696270ff80d59f6d1c9502f9.jpeg 800w,https://ao.parliament.nz/gfx/4-education-c-kathryn-taylor-truestock.jpg/@@images/image-1200-ca7a6580e6ad4762bcd9b7752118911b.jpeg 1200w,https://ao.parliament.nz/gfx/4-education-c-kathryn-taylor-truestock.jpg/@@images/image-1600-11e19ed6fc8994b300eb3da2b15a9a74.jpeg 1600w\"></source><img alt=\"Education \u00a9 Kathryn Taylor, Truestock\" class=\"card-img-top\" height=\"281\" loading=\"lazy\" src=\"https://ao.parliament.nz/gfx/4-education-c-kathryn-taylor-truestock.jpg/@@images/image-1000-26f823057d364cf8b7ce4efad4f895e1.jpeg\" title=\"Education \u00a9 Kathryn Taylor, Truestock\" width=\"500\" /></picture>\n<div class=\"card-body\">\n<h4 class=\"card-title\"><a href=\"https://ao.parliament.nz/2026/school-lunches/index.htm\" title=\"Inquiry into the Healthy School Lunches Programme\">Inquiry into the Healthy School Lunches Programme</a></h4>\n<p class=\"card-text\">In 2024, Cabinet approved a new model for providing school lunches. The aims were reducing costs, waste, and surplus lunches. The Ministry of Education contracted the School Lunch Collective to deliver this new model from January 2025. We carried out an inquiry into the programme, looking at how the Ministry developed options, procured suppliers, put the contract in place, and monitored performance.</p>\n<a class=\"btn btn-primary\" href=\"https://ao.parliament.nz/2026/school-lunches/index.htm\" title=\"Inquiry into the Healthy School Lunches Programme\">Read more</a></div>\n</div>\n</div>\n<div class=\"col\">\n<div class=\"card h-100\"><picture><source srcset=\"https://ao.parliament.nz/gfx/sky-pattern-4.png/@@images/image-1000-1e194554b7ec5943b02318a19af24592.png 1000w,https://ao.parliament.nz/gfx/sky-pattern-4.png/@@images/image-400-46d16ff725a54d0f2312ba866db7ad7a.png 400w,https://ao.parliament.nz/gfx/sky-pattern-4.png/@@images/image-600-ae92dc9b6996c98b137d686211083b54.png 600w,https://ao.parliament.nz/gfx/sky-pattern-4.png/@@images/image-800-947ecb69e422c2fbc99daec27bed76ee.png 800w,https://ao.parliament.nz/gfx/sky-pattern-4.png/@@images/image-1200-dc36265fae182e34a321542703e75050.png 1200w,https://ao.parliament.nz/gfx/sky-pattern-4.png/@@images/image-1600-d3f15dce538c5148b42d420bcc7b1c1f.png 1600w\"></source><img alt=\"...\" class=\"card-img-top\" height=\"281\" loading=\"lazy\" src=\"https://ao.parliament.nz/gfx/sky-pattern-4.png/@@images/image-1000-1e194554b7ec5943b02318a19af24592.png\" title=\"Sky pattern 4\" width=\"500\" /></picture>\n<div class=\"card-body\">\n<h4 class=\"card-title\"><a href=\"https://ao.parliament.nz/2026/annual-plan/index.htm\" title=\"Annual plan 2026/27\">Annual plan 2026/27</a></h4>\n<p class=\"card-text\">Although the most significant element of our work is our mandatory audit function, we also have a discretionary programme of work that includes performance audits, inquiries, good practice guidance, and a range of other products. The work programme priorities identified in our Annual Plan 2026/27 will drive our discretionary work.</p>\n<a class=\"btn btn-primary\" href=\"https://ao.parliament.nz/2026/annual-plan/index.htm\" title=\"Annual plan 2026/27\">Read more</a></div>\n</div>\n</div>\n<div class=\"col\">\n<div class=\"card h-100\"><picture><source srcset=\"https://ao.parliament.nz/gfx/paua-c-erica-sinclair-truestock.jpg/@@images/image-1000-ded3fcb078726f3cb1579476d3c6d8a3.jpeg 1000w,https://ao.parliament.nz/gfx/paua-c-erica-sinclair-truestock.jpg/@@images/image-400-5c5ca0ad34e34091403b91234176f522.jpeg 400w,https://ao.parliament.nz/gfx/paua-c-erica-sinclair-truestock.jpg/@@images/image-600-7b1a72c716c1d7929de12adeba309254.jpeg 600w,https://ao.parliament.nz/gfx/paua-c-erica-sinclair-truestock.jpg/@@images/image-800-2f99244556892877e6ce6e70f45451b5.jpeg 800w,https://ao.parliament.nz/gfx/paua-c-erica-sinclair-truestock.jpg/@@images/image-1200-0548619208f440923a02bf3ca8e0ed29.jpeg 1200w,https://ao.parliament.nz/gfx/paua-c-erica-sinclair-truestock.jpg/@@images/image-1600-39bc2fe7cebb9ea003f25f2f7518736e.jpeg 1600w\"></source><img alt=\"P\u0101ua shell\" class=\"card-img-top\" height=\"281\" loading=\"lazy\" src=\"https://ao.parliament.nz/gfx/paua-c-erica-sinclair-truestock.jpg/@@images/image-1000-ded3fcb078726f3cb1579476d3c6d8a3.jpeg\" title=\"p\u0101ua \u00a9 Erica Sinclair, Truestock\" width=\"500\" /></picture>\n<div class=\"card-body\">\n<h4 class=\"card-title\">Vacancies</h4>\n<p class=\"card-text\">We\u2019re looking for a <a href=\"https://jobs.govt.nz/jobs/NZ-1934179\" title=\"Manager, Strategy and Performance job advert on jobs.govt.nz website\">Manager</a> for our Strategy and Performance team for a fixed-term or secondment, <a href=\"https://jobs.govt.nz/jobs/NZ-1935865\" title=\"Senior and Inquiries Specialists job advert on jobs.govt.nz website\">an Inquiries Specialist, and a Senior Inquiries Specialist</a> for our <span>Legal, Knowledge and Practice Group</span>.</p>\n<a class=\"btn btn-primary\" href=\"https://ao.parliament.nz/about-us/careers/index.htm\" title=\"Careers\">Read more</a></div>\n</div>\n</div>\n<div class=\"col\">\n<div class=\"card h-100\"><picture><source srcset=\"https://ao.parliament.nz/gfx/sunset-pattern-1.png/@@images/image-1000-91d098661cb5157e86a1edbeca6e7ba7.png 1000w,https://ao.parliament.nz/gfx/sunset-pattern-1.png/@@images/image-400-5db78e650ee8d834714d68ac63df869e.png 400w,https://ao.parliament.nz/gfx/sunset-pattern-1.png/@@images/image-600-eabd3d64f533b937aff85fab0b9624e1.png 600w,https://ao.parliament.nz/gfx/sunset-pattern-1.png/@@images/image-800-63228ae4eb8803371641e74974d580b5.png 800w,https://ao.parliament.nz/gfx/sunset-pattern-1.png/@@images/image-1200-1bfcb02daca0cc519f3098c2625ac802.png 1200w,https://ao.parliament.nz/gfx/sunset-pattern-1.png/@@images/image-1600-36d8fbea2a085ff5431c13ddb450a055.png 1600w\"></source><img alt=\"A pattern on a pink background\" class=\"card-img-top\" height=\"281\" loading=\"lazy\" src=\"https://ao.parliament.nz/gfx/sunset-pattern-1.png/@@images/image-1000-91d098661cb5157e86a1edbeca6e7ba7.png\" title=\"lavender \u00a9 Emma Diack, Truestock\" width=\"500\" /></picture>\n<div class=\"card-body\">\n<h4 class=\"card-title\"><a href=\"https://ao.parliament.nz/2026/publicity-material/index.htm\" title=\"Parliamentary Service funding of publicity material\">Parliamentary Service funding of publicity material</a></h4>\n<p class=\"card-text\">Our Office received questions from members of the public about publicity material carrying a \u201cfunded by the Parliamentary Service\u201d statement and/or the parliamentary crest. People wanted to know whether that material complied with the rules for using parliamentary funding.</p>\n<p class=\"card-text\">This letter sets out the work we have done and our observations.</p>\n<a class=\"btn btn-primary\" href=\"https://ao.parliament.nz/2026/publicity-material/index.htm\" title=\"Parliamentary Service funding of publicity material\">Read more</a></div>\n</div>\n</div>\n<div class=\"col\">\n<div class=\"card h-100\"><picture><source srcset=\"https://ao.parliament.nz/gfx/lavender-c-emma-diack-truestock.jpg/@@images/image-1000-8989c9264b79081c9bf6db907733ae08.jpeg 1000w,https://ao.parliament.nz/gfx/lavender-c-emma-diack-truestock.jpg/@@images/image-400-19857da463d321a0f8b70c42c2d5525e.jpeg 400w,https://ao.parliament.nz/gfx/lavender-c-emma-diack-truestock.jpg/@@images/image-600-822d32480aa826e5ddd2c32574f05347.jpeg 600w,https://ao.parliament.nz/gfx/lavender-c-emma-diack-truestock.jpg/@@images/image-800-6b913b3e279d05a69fdc166c24c64aa2.jpeg 800w,https://ao.parliament.nz/gfx/lavender-c-emma-diack-truestock.jpg/@@images/image-1200-44b35fa05864fddc2e53a07306198695.jpeg 1200w,https://ao.parliament.nz/gfx/lavender-c-emma-diack-truestock.jpg/@@images/image-1600-ef1b983c1b7d16b2e02f7d095821479b.jpeg 1600w\"></source><img alt=\"...\" class=\"card-img-top\" height=\"281\" loading=\"lazy\" src=\"https://ao.parliament.nz/gfx/lavender-c-emma-diack-truestock.jpg/@@images/image-1000-8989c9264b79081c9bf6db907733ae08.jpeg\" title=\"lavender \u00a9 Emma Diack, Truestock\" width=\"500\" /></picture>\n<div class=\"card-body\">\n<h4 class=\"card-title\"><a href=\"https://ao.parliament.nz/blog/2026/free-and-frank\" title=\"Blog post: The craft of free and frank advice\">Blog post: The craft of free and frank advice</a></h4>\n<p class=\"card-text\">At the Transparency International New Zealand (TINZ) Leaders Integrity Forum in March, public sector leaders gathered to talk about free and frank advice \u2013 what it actually is, how practitioners understand it, and why it has resisted definition for so long. Senior Advisor Good Practice &amp; Policy, Cas Alabere, shares key points and reflections from the discussion.</p>\n<a class=\"btn btn-primary\" href=\"https://ao.parliament.nz/blog/2026/free-and-frank\" title=\"Blog post: The craft of free and frank advice\">Read more</a></div>\n</div>\n</div>\n</div>\n<div class=\"card mb-3\">\n<div class=\"row g-0\">\n<div class=\"col-md-4\"><picture><source srcset=\"https://ao.parliament.nz/about-us/our-people/gfx/grant-taylor-profile.jpg/@@images/image-1000-793c0acfb9e27c7b92764a030f7c5896.png 1000w,https://ao.parliament.nz/about-us/our-people/gfx/grant-taylor-profile.jpg/@@images/image-400-2eafc18d14cb359b11001fd566d361f6.png 400w,https://ao.parliament.nz/about-us/our-people/gfx/grant-taylor-profile.jpg/@@images/image-600-6ba4613a25ba5eeebe16198ced603d12.png 600w,https://ao.parliament.nz/about-us/our-people/gfx/grant-taylor-profile.jpg/@@images/image-800-4ddbaca41cd409ea5711e628308963e2.png 800w,https://ao.parliament.nz/about-us/our-people/gfx/grant-taylor-profile.jpg/@@images/image-1200-56ae562058578d12a43e2866bb9163fd.png 1200w,https://ao.parliament.nz/about-us/our-people/gfx/grant-taylor-profile.jpg/@@images/image-1600-5dabcebbb6f91f73442e7df3fba19999.png 1600w\"></source><img alt=\"Grant Taylor, Controller and Auditor-General\" class=\"image-richtext image-inline picture-variant-large; rounded-start\" height=\"281\" loading=\"lazy\" src=\"https://ao.parliament.nz/about-us/our-people/gfx/grant-taylor-profile.jpg/@@images/image-1000-793c0acfb9e27c7b92764a030f7c5896.png\" title=\"Grant Taylor, Controller and Auditor-General\" width=\"500\" /></picture></div>\n<div class=\"col-md-8\">\n<div class=\"card-body\">\n<h3 class=\"card-title\">The Controller and Auditor-General</h3>\n<p class=\"card-text\">The Controller and Auditor-General (Grant Taylor) is independent of the Government. He is responsible for the audits of about 3300 public organisations, including government departments, State-owned enterprises, public research organisations, the defence forces, health agencies, city and district councils and the subsidiary companies they own, ports, schools, universities, polytechnics, and w\u0101nanga.</p>\n<p>Our main role is <a href=\"https://ao.parliament.nz/annual-audits\" title=\"Annual auditing\">auditing</a>, which is required by legislation and makes up about 88% of our work.</p>\n</div>\n</div>\n</div>\n</div>\n<p class=\"small\"><em>Main photo: Paihia in the Bay of Islands, \u00a9 ZambeziShark, iStock</em></p></div>\n        </section>\n\n      \n    \n              </div>\n\n              <div id=\"viewlet-below-content-body\">\n\n\n\n\n\n\n</div>\n\n            \n            <footer>\n              <div id=\"viewlet-below-content\">\n\n\n\n\n\n\n</div>\n            </footer>\n          </article>\n        \n      \n\n      \n    </section>\n          \n          \n        </main>\n        <!--/row-->\n      </div>\n      <!--/container-->\n\n    </div><!--/outer-wrapper --><footer class=\"mt-auto\" id=\"portal-footer-wrapper\">\n      <div class=\"container\" id=\"portal-footer\">\n        <div class=\"doormat row\">\n    \n    \n    \n    \n  </div>\n        <div class=\"site-actions row\">\n          <div class=\"col-12\"><ul class=\"actions-site_actions\">\n        \n          <li class=\"portletItem action-item-contact\">\n            <a href=\"https://ao.parliament.nz/contact-us\">\n              <span>contact us</span>\n              \n            </a>\n          </li>\n        \n          <li class=\"portletItem action-item-sitemap\">\n            <a href=\"https://ao.parliament.nz/about-this-site\">\n              <span>about this site</span>\n              \n            </a>\n          </li>\n        \n          <li class=\"portletItem action-item-auditing-standards\">\n            <a href=\"https://ao.parliament.nz/auditing-standards\">\n              <span>auditing standards</span>\n              \n            </a>\n          </li>\n        \n          <li class=\"portletItem action-item-auditors\">\n            <a href=\"https://portal.oag.parliament.nz/\">\n              <span>audit office portal (auditors only)</span>\n              \n            </a>\n          </li>\n        \n      </ul></div>\n        </div>\n        <div class=\"colophon row\">\n          <div class=\"col-12\">\n    <ul>\n      <li class=\"hiddenStructure\" id=\"colophon-accessibility\">\n        <a href=\"https://ao.parliament.nz/about-this-site/accessibility\" title=\"Accessibility\">accessibility</a>\n      </li>\n      <li id=\"colophon-address\" title=\"address\">\n            The Audit Office, 100 Molesworth Street, Thorndon, Wellington 6011 | +64\u00a04\u00a0917\u00a01500 |\n        <span class=\"link-mailto\"><a href=\"/cdn-cgi/l/email-protection#4a2f243b3f2338330a2b25643a2b3826232b272f243e642430\"><span class=\"__cf_email__\" data-cfemail=\"97f2f9e6e2fee5eed7f6f8b9e7f6e5fbfef6faf2f9e3b9f9ed\">[email&#160;protected]</span></a></span>\n      </li>\n      <li id=\"colophon-copyright\" title=\"crown copyright\"><a href=\"https://ao.parliament.nz/about-this-site/#copyright\">\u00a9 crown copyright 2001-<span>2026</span></a>\n      </li></ul>\n    <ul class=\"oag-social\" id=\"document-actions-social\">\n      <li id=\"document-actions-facebook\">\n        <a href=\"https://facebook.com//auditorgeneralnz\" title=\"Follow us on Facebook\">\n          <span class=\"fab fa-facebook\"></span>\n        </a>\n      </li>\n      <li id=\"document-actions-instagram\">\n        <a href=\"https://www.instagram.com/theauditofficenz/\" title=\"Follow us on Instagram\">\n          <span class=\"fab fa-instagram\">\n          </span>\n        </a>\n      </li>\n      <li id=\"document-actions-linkedin\">\n        <a href=\"https://www.linkedin.com/company/ao-new-zealand/\" title=\"Follow us on LinkedIn\">\n          <span class=\"fab fa-linkedin\"></span>\n        </a>\n      </li>\n      <li id=\"document-actions-oagrss\">\n        <a href=\"https://ao.parliament.nz/atom.xml\" title=\"Subscribe to our RSS feed\">\n          <span class=\"fas fa-rss\"></span>\n        </a>\n      </li>\n      <li id=\"document-actions-oagsubs\">\n        <a href=\"https://ao.parliament.nz/contact-us/email-subs\" title=\"Subscribe to email updates\">\n          <span class=\"fas fa-envelope\"></span>\n        </a>\n      </li>\n    </ul>\n  </div>\n        </div>\n      </div>\n    </footer><script data-cfasync=\"false\" src=\"/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js\"></script></body>\n\n</html>",
