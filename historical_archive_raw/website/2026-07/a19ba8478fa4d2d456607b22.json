  "html": "<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" class=\"h-100\" lang=\"en-nz\" xml:lang=\"en-nz\">\n\n  <head>\n<base href=\"https://ao.parliament.nz/home/\" />\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n    <title>Home \u2014 The Audit Office</title>\n    <link href=\"/++theme++oag2025/++theme++oag2025/oag2025-favicon.svg\" rel=\"icon\" type=\"image/svg+xml\" />\n    <link href=\"/++theme++oag2025/++theme++oag2025/oag2025-favicon.ico\" rel=\"icon\" />\n    <link href=\"/++theme++oag2025/++theme++oag2025/oag2025-apple-touch-icon.png\" rel=\"apple-touch-icon\" />\n  <meta charset=\"utf-8\" /><meta name=\"twitter:card\" content=\"summary\" /><meta property=\"og:site_name\" content=\"The Audit Office\" /><meta property=\"og:title\" content=\"Home\" /><meta property=\"og:type\" content=\"website\" /><meta property=\"og:article:publisher\" content=\"https://www.facebook.com/auditorgeneralnz\" /><meta property=\"og:description\" content=\"\" /><meta property=\"og:url\" content=\"https://ao.parliament.nz\" /><meta property=\"og:image\" content=\"https://ao.parliament.nz/home/@@images/image-1200-4cf712e9c379bc24f43e20d16868039b.jpeg\" /><meta property=\"og:image:width\" content=\"1200\" /><meta property=\"og:image:height\" content=\"292\" /><meta property=\"og:image:type\" content=\"image/jpeg\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" /><meta name=\"generator\" content=\"Plone - https://plone.org/\" /><link href=\"https://ao.parliament.nz/about-us/news/most-recent-announcements/atom.xml\" rel=\"alternate\" title=\"Recent news - b'Atom'\" type=\"application/rss+xml\" /><link href=\"https://ao.parliament.nz/resources/latest/atom.xml\" rel=\"alternate\" title=\"Latest resources - b'Atom'\" type=\"application/rss+xml\" /><link href=\"https://ao.parliament.nz/blog/latest-posts/atom.xml\" rel=\"alternate\" title=\"Latest blog posts - b'Atom'\" type=\"application/rss+xml\" /><link href=\"