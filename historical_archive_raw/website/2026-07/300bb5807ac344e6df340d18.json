n        <div id=\"mainnavigation\">\n          <nav class=\"navbar navbar-expand-lg navbar-barceloneta pat-navigationmarker\" id=\"portal-globalnav-wrapper\">\n            <div class=\"container\">\n              <div class=\"offcanvas offcanvas-end\" id=\"offcanvasNavbar\" aria-labelledby=\"offcanvasNavbarLabel\" tabindex=\"-1\">\n                <div class=\"offcanvas-header justify-content-end\">\n                  <button class=\"btn-close btn-close-white text-reset\" aria-label=\"Close\" type=\"button\" data-bs-dismiss=\"offcanvas\"></button>\n                </div>\n                <div class=\"offcanvas-body align-items-center\">\n                  <ul class=\"navbar-nav me-auto\" id=\"portal-globalnav\">\n    <li class=\"about-us nav-item\"><a href=\"https://ao.parliament.nz/about-us\" class=\"state-published nav-link\">About us</a></li><li class=\"annual-audits nav-item\"><a href=\"https://ao.parliament.nz/annual-audits\" class=\"state-published nav-link\">Annual audits</a></li><li class=\"resources nav-item\"><a href=\"https://ao.parliament.nz/resources\" class=\"state-published nav-link\">Resources</a></li><li class=\"work-programme nav-item\"><a href=\"https://ao.parliament.nz/work-programme\" class=\"state-published nav-link\">Work programme</a></li>\n  </ul>\n                  <div class=\"d-flex flex-column position-relative\" id=\"portal-searchbox\">\n\n  <form class=\"d-flex pat-livesearch show_images\" id=\"searchGadget_form\" action=\"https://ao.parliament.nz/@@search\" role=\"search\" data-pat-livesearch=\"ajaxUrl:https://ao.parliament.nz/@@ajax-search\">\n\n    <input name=\"oagSearchReturn\" type=\"hidden\" value=\"Recent news\" />\n\n    <label class=\"hiddenStructure\" for=\"searchGadget\">Search Site</label>\n\n    <input class=\"searchField form-control me-2\" id=\"searchGadget\" name=\"SearchableText\" placeholder=\"Search Site\" size=\"18\" title=\"Search Site\" type=\"text\" />\n\n    <button class=\"searchButton btn btn-outline-light\" type=\"submit\">Search</button>\n\n    <div class=\"hiddenStructure\" id=\"portal-advanced-search\">\n      <a href=\"https://ao.parliament.nz/@@search\">Advanced Search\u2026</a>\n    </div>\n\n  </form>\n\n</div>\n                </div>\n              </div>\n            </div>\n          </nav>\n        </div>\n      </div>\n\n      \n\n      <div id=\"above-content-wrapper\">\n        <div id=\"viewlet-above-content\">\n<nav id=\"portal-breadcrumbs\" aria-label=\"breadcrumb\">\n  <div class=\"container\">\n    <ol class=\"breadcrumb\">\n      <li class=\"breadcrumb-item\"><a href=\"https://ao.parliament.nz\">Home</a></li>\n      \n        <li class=\"breadcrumb-item\"><a href=\"https://ao.parliament.nz/about-us\">About us</a></li>\n        \n      \n        \n        <li class=\"breadcrumb-item active\" aria-current=\"page\">News</li>\n      \n    </ol>\n  </div>\n</nav>\n</div>\n      </div>\n\n      <div class=\"container\">\n        <div class=\"row\">\n          <aside class=\"col-12\" id=\"global_statusmessage\">\n      \n\n      <div>\n      </div>\n    </aside>\n        </div>\n        <main class=\"row\" id=\"main-container\">\n          <section id=\"portal-column-content\">\n\n      \n\n      \n\n        \n\n          <article id=\"content\">\n\n            \n\n              <header>\n\n                <div id=\"viewlet-above-content-title\"><span id=\"social-tags-body\" itemscope=\"\" itemtype=\"http://schema.org/WebPage\" style=\"display: none\">\n  <span itemprop=\"name\">Recent news</span>\n  <span itemprop=\"description\"></span>\n  <span itemprop=\"url\">https://ao.parliament.nz/about-us/news</span>\n  <span itemprop=\"image\">https://ao.parliament.nz/@@site-logo/ao_logo.svg</span>\n</span>\n</div>\n\n                \n                  <h1>Recent news</h1>\n\n                \n\n                <div id=\"viewlet-below-content-title\">\n</div>\n\n                \n                  \n\n                \n\n                <div id=\"viewlet-below-content-description\"></div>\n\n              </header>\n\n              <div id=\"viewlet-above-content-body\">\n\n\n\n\n\n</div>\n\n              <div id=\"content-core\">\n                \n      \n\n        \n\n        <div class=\"plain\" id=\"parent-fieldname-text\">\n          <h3>Please note...</h3>\n<p>For media queries, please email<span>\u00a0</span><a href=\"/cdn-cgi/l/email-protection#39545c5d50587958561749584b555058545c574d175743064a4c5b535c5a4d04684c5c4b401c0b095f4b56541c0b094d515c1c0b09775c4e4a1c0b094a5c5a4d5056571c0b09565f1c0b094d515c1c0b094e5c5b4a504d5c\"><span class=\"__cf_email__\" data-cfemail=\"442921202d2504252b6a342536282d2529212a306a2a3e\">[email&#160;protected]</span></a><span>\u00a0</span>or call 021 222 9708. We strongly recommend that members of the media <a href=\"https://ao.parliament.nz/contact-us/email-subs\">subscribe to our email service</a> to receive announcements as soon as we make them.</p>\n<p>We have <a href=\"https://ao.parliament.nz/about-us/our-people/hi-res-images\">high-resolution images</a> available for the leadership team, in the About us/Our people section.</p>\n<p>If we\u00a0<a href=\"https://ao.parliament.nz/about-us/what-we-do/inquiries\" title=\"About us | What we do | Inquiries\">decide to carry out an inquiry</a>, we won't normally comment further until we release our report. It is hard to predict when we might be ready to report our findings.</p>\n        </div>\n\n\n        \n          \n            \n              \n            \n                  \n                    \n\n                <article class=\"row mb-3\">\n\n                  <div class=\"col\">\n\n                    <h2>\n                      <a class=\"summary url\" href=\"https://ao.parliament.nz/about-us/news/2026/media-release-school-lunches\" title=\"News Item\">Media release: Inquiry into the Healthy School Lunches Programme</a>\n                    </h2>\n\n                    <div class=\"mb-3\">\n                      \n                              <div class=\"mb-1\">\n                                <div class=\"oag-blog-byline documentByLine\">\n                                  \n\n                                  \n                                  \n                                </div>\n                              </div>\n                    </div>\n\n                    <div class=\"mb-1\">\n                      <span class=\"description\">30 June 2026: Auditor-General finds savings in school lunches rollout, but issues remain.</span>\n                    </div>\n\n                    <div class=\"mb-1\">\n                      <a href=\"https://ao.parliament.nz/about-us/news/2026/media-release-school-lunches\">Read More\u2026</a>\n                    </div>\n\n                  </div>\n\n                  \n\n                </article>\n\n              \n                  \n                \n                  \n                    \n\n                <article class=\"row mb-3\">\n\n                  <div class=\"col\">\n\n                    <h2>\n                      <a class=\"summary url\" href=\"https://ao.parliament.nz/about-us/news/2026/kaipara-inquiry\" title=\"News Item\">Terms of reference for inquiry into Kaipara District Council</a>\n                    </h2>\n\n                    <div class=\"mb-3\">\n                      \n                              <div class=\"mb-1\">\n                                <div class=\"oag-blog-byline documentByLine\">\n                                  \n\n                                  \n                                  \n                                </div>\n                              </div>\n                    </div>\n\n                    <div class=\"mb-1\">\n                      <span class=\"description\">20 May 2026: We have decided to carry out an inquiry into Kaipara District Council\u2019s (the Council\u2019s) procurement, contract management, and governance practices. These terms of reference set out the background and scope for the inquiry.</span>\n                    </div>\n\n                    <div class=\"mb-1\">\n                      <a href=\"https://ao.parliament.nz/about-us/news/2026/kaipara-inquiry\">Read More\u2026</a>\n                    </div>\n\n                  </div>\n\n                  \n\n                </article>\n\n              \n                  \n                \n                  \n                    \n\n                <article class=\"row mb-3\">\n\n                  <div class=\"col\">\n\n                    <h2>\n                      <a class=\"summary url\" href=\"https://ao.parliament.nz/about-us/news/2026/new-direction-and-name\" title=\"News Item\">Media release: Auditor-General announces refreshed direction and new name</a>\n                    </h2>\n\n                    <div class=\"mb-3\">\n                      \n                              <div class=\"mb-1\">\n                                <div class=\"oag-blog-byline documentByLine\">\n                                  \n\n                                  \n                                  \n                                </div>\n                              </div>\n                    </div>\n\n                    <div class=\"mb-1\">\n                      <span class=\"description\">30 April 2026: The Auditor-General\u2019s strategic intentions to 2031 were presented to Parliament today, signalling an ambition to drive further positive change in public sector performance and accountability.</span>\n                    </div>\n\n                    <div class=\"mb-1\">\n                      <a href=\"https://ao.parliament.nz/about-us/news/2026/new-direction-and-name\">Read More\u2026</a>\n                    </div>\n\n                  </div>\n\n                  \n\n                </article>\n\n              \n                  \n                \n                  \n                    \n\n                <article class=\"row mb-3\">\n\n                  <div class=\"col\">\n\n                    <h2>\n                      <a class=\"summary url\" href=\"https://ao.parliament.nz/about-us/news/2026/engagement-with-maori\" title=\"News Item\">Media release: Public service needs to improve capability to engage with M\u0101ori</a>\n                    </h2>\n\n                    <div class=\"mb-3\">\n                      \n                              <div class=\"mb-1\">\n                                <div class=\"oag-blog-byline documentByLine\">\n                                  \n\n                                  \n                                  \n                                </div>\n                              </div>\n                    </div>\n\n                    <div class=\"mb-1\">\n                      <span class=\"description\">23 April 2026: Each public service agency needs to examine how and why capability matters for its specific context and work, says the Auditor-General.</span>\n                    </div>\n\n                    <div class=\"mb-1\">\n                      <a href=\"https://ao.parliament.nz/about-us/news/2026/engagement-with-maori\">Read More\u2026</a>\n                    </div>\n\n                  </div>\n\n                  \n\n                </article>\n\n              \n                  \n                \n                  \n                    \n\n                <article class=\"row mb-3\">\n\n                  <div class=\"col\">\n\n                    <h2>\n                      <a class=\"summary url\" href=\"https://ao.parliament.nz/about-us/news/2026/housing-need\" title=\"News Item\">Media release: Strengthening support for people in immediate housing need</a>\n                    </h2>\n\n                    <div class=\"mb-3\">\n                      \n                              <div class=\"mb-1\">\n                                <div class=\"oag-blog-byline documentByLine\">\n                                  \n\n                                  \n                                  \n                                </div>\n                              </div>\n                    </div>\n\n                    <div class=\"mb-1\">\n                      <span class=\"description\">25 March 2026: The Ministry of Social Development and the Ministry of Housing and Urban Development should work together to build a more comprehensive national picture of immediate housing need to inform decisions about how best to target government-funded support.</span>\n                    </div>\n\n                    <div class=\"mb-1\">\n                      <a href=\"https://ao.parliament.nz/about-us/news/2026/housing-need\">Read More\u2026</a>\n                    </div>\n\n                  </div>\n\n                  \n\n                </article>\n\n              \n                  \n                \n          \n\n              \n\n      <!-- Navigation -->\n\n\n  \n\n\n\n\n    \n\n            \n\n            \n              \n            \n\n          \n        \n\n      \n\n      \n    \n              </div>\n\n              <div id=\"viewlet-below-content-body\">\n\n\n\n\n\n\n</div>\n\n            \n            <footer>\n              <div id=\"viewlet-below-content\">\n\n\n\n\n\n\n</div>\n            </footer>\n          </article>\n        \n      \n\n      \n    </section>\n          <aside id=\"portal-column-one\">\n          \n      \n        \n  <div class=\"portletWrapper\" id=\"portletwrapper-706c6f6e652e6c656674636f6c756d6e0a636f6e746578740a2f6f61672f61626f75742d75732f6e6577730a616e6e6f756e63656d656e74732d66726f6d\" data-portlethash=\"706c6f6e652e6c656674636f6c756d6e0a636f6e746578740a2f6f61672f61626f75742d75732f6e6577730a616e6e6f756e63656d656e74732d66726f6d\">\n\n  \n\n  <div class=\"card portlet portletStaticText portlet-static-news-from\">\n\n    <div class=\"card-header\">\n      News from...\n    </div>\n\n    <div class=\"card-body\">\n      <div><p><a href=\"https://ao.parliament.nz/about-us/news/20