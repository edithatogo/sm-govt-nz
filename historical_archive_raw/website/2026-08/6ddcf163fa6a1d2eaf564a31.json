=\"614\" alt=\"Mobile portrait 800px x 614px\" src=\"/assets/Uploads/Home-page/Hero-banner/Mobile-portrait-800px-x-614px.jpg\" loading=\"lazy\" />\n\n</picture>\n\n</div>\n\n<div class=\"element-banner__content\">\n  <div class=\"element-banner__container dn--grid max center\">\n    \n        <h1 class=\"element-banner__title text-shadow\">Stronger Connections<br />\r\nBetter New Zealand</h1>\n    \n    <div class=\"hero-banner__logo\"></div>\n  </div>\n</div>\n\n</div>\n\n\n<div class=\"container\">\n  \n    <div class=\"element element-spotlight-list\" id=\"e387\">\n\t\n  <div class=\"element-spotlight-list__container dn--grid max\">\n    \n    <div class=\"element-spotlight-list__list dn--row\">\n      \n        <div class=\"element-spotlight dn--col-xs-12 dn--col-lg-3 has-hover-effect\">\n  <div class=\"element-spotlight__content\">\n    \n      <div class=\"element-spotlight__image\">\n        <div class=\"lazyload-container\">\n  <img\n    class=\"lazyload blur-up\"\n    src=\"/assets/Uploads/Home-page/Spotlights/Interislander-Cafe-Play1000x667px__QualityWzIwXQ.jpg\"\n    data-src=\"/assets/Uploads/Home-page/Spotlights/Interislander-Cafe-Play1000x667px.jpg\"\n    alt=\"Interislander Cafe Play1000x667px\"\n  />\n</div>\n      </div>\n    \n\n    <div class=\"element-spotlight__text\">\n      \n        <h3 class=\"element-spotlight__title\">Customer Experience</h3>\n      \n\n      <p>Our Interislander menu suppliers provide top quality food &amp; beverages.</p>\n    </div>\n\n    \n      \n        \n  <a class=\" dn--link element-spotlight__link hide-external-link\" href=\"https://youtu.be/BxCZ35apffI\">\n    Watch short video\n  </a>\n\n\n      \n    \n  </div>\n</div>\n\n      \n        <div class=\"element-spotlight dn--col-xs-12 dn--col-lg-3 has-hover-effect\">\n  <div class=\"element-spotlight__content\">\n    \n      <div class=\"element-spotlight__image\">\n        <div class=\"lazyload-container\">\n  <img\n    class=\"lazyload blur-up\"\n    src=\"/assets/Uploads/Home-page/Spotlights/Zero-Harm_1000x667px__QualityWzIwXQ.jpg\"\n    data-src=\"/assets/Uploads/Home-page/Spotlights/Zero-Harm_1000x667px.jpg\"\n    alt=\"Zero Harm 1000x667px\"\n  />\n</div>\n      </div>\n    \n\n    <div class=\"element-spotlight__text\">\n      \n        <h3 class=\"element-spotlight__title\">Health, Safety &amp; Wellbeing</h3>\n      \n\n      <p>We want our people and the public to go home safe to their families every day.</p>\n    </div>\n\n    \n      \n        \n  <a class=\" dn--link element-spotlight__link hide-external-link\" href=\"/who-we-are/safety/\">\n     Our safety vision\n  </a>\n\n\n      \n    \n  </div>\n</div>\n\n      \n        <div class=\"element-spotlight dn--col-xs-12 dn--col-lg-3 has-hover-effect\">\n  <div class=\"element-spotlight__content\">\n    \n      <div class=\"element-spotlight__image\">\n        <div class=\"lazyload-container\">\n  <img\n    class=\"lazyload blur-up\"\n    src=\"/assets/Uploads/Home-page/Spotlights/GJNZ_1000x667px__QualityWzIwXQ.jpg\"\n    data-src=\"/assets/Uploads/Home-page/Spotlights/GJNZ_1000x667px.jpg\"\n    alt=\"GJNZ 1000x667px\"\n  />\n</div>\n      </div>\n    \n\n    <div class=\"element-spotlight__text\">\n      \n        <h3 class=\"element-spotlight__title\">Great Journeys NZ</h3>\n      \n\n      <p>Experience Aotearoa aboard our world-famous scenic train journeys.</p>\n    </div>\n\n    \n      \n        \n  <a class=\" dn--link element-spotlight__link hide-external-link\" href=\"https://www.greatjourneysnz.com/\" target='_blank' rel='noopener'>\n    Book now\n  </a>\n\n\n      \n    \n  </div>\n</div>\n\n      \n        <div class=\"element-spotlight dn--col-xs-12 dn--col-lg-3 has-hover-effect\">\n  <div class=\"element-spotlight__content\">\n    \n      <div class=\"element-spotlight__image\">\n        <div class=\"lazyload-container\">\n  <img\n    class=\"lazyload blur-up\"\n    src=\"/assets/Uploads/Who-we-are/Sustainability-v2/Carbon-Calculator__QualityWzIwXQ.jpg\"\n    data-src=\"/assets/Uploads/Who-we-are/Sustainability-v2/Carbon-Calculator.jpg\"\n    alt=\"Carbon Calculator\"\n  />\n</div>\n      </div>\n    \n\n    <div class=\"element-spotlight__text\">\n      \n        <h3 class=\"element-spotlight__title\">Sustainability </h3>\n      \n\n      <p>Initiatives like our Carbon Calculator, a free tool for estimating emissions.</p>\n    </div>\n\n    \n      \n        \n  <a class=\" dn--link element-spotlight__link hide-external-link\" href=\"/who-we-are/sustainability/\">\n    Our sustainability commitment\n  </a>\n\n\n      \n    \n  </div>\n</div>\n\n      \n    </div>\n  </div>\n\n\n\n\n\n\n</div>\n\n  \n    <div class=\"element element-media media-left-half\" id=\"e1821\">\n\t\n  <style>\n  .element#e1821 .intrinsic:after {\n    padding-bottom: calc(674 / 1200 * 100%);\n  }\n  </style>\n\n\n<div class=\"element-media__content-container\">\n  <div class=\"element-media__content\">\n    <div class=\"element-media__text-container\">\n      \n        <h3 class=\"element-media__title\">Carbon Calculator - emissions estimation tool</h3>\n      \n\n      \n        <p>The Carbon Calculator is a handy digital tool that lets users input information about potential freight travel on the KiwiRail network, then estimates the emissions created by that journey and compares it to equivalent journeys by road. <br />\r\nCustomers can find it now on the freight portal in the left-hand navigation menu. It\u2019s also available on our Sustainability page.</p>\n      \n\n      \n        \n          \n  <a class=\" dn--link\" href=\"https://www.kiwirail.co.nz/who-we-are/sustainability/#CarbonCalculator\">\n    Carbon Calculator\n  </a>\n\n\n        \n      \n    </div>\n  </div>\n</div>\n\n\n  <div class=\"element-media__media\">\n    \n      <div class=\"element-media__image\">\n        <div class=\"lazyload-container\">\n  <img\n    class=\"lazyload blur-up\"\n    src=\"/assets/Uploads/Who-we-are/Sustainability-v2/DJI_0344-2-v2__QualityWzIwXQ.jpg\"\n    data-src=\"/assets/Uploads/Who-we-are/Sustainability-v2/DJI_0344-2-v2.jpg\"\n    alt=\"DJI 0344 (2)\"\n  />\n</div>\n      </div>\n    \n\n    \n  </div>\n\n\n</div>\n\n  \n    <div class=\"element element-media media-right-half\" id=\"e392\">\n\t\n\n<div class=\"element-media__content-container\">\n  <div class=\"element-media__content\">\n    <div class=\"element-media__text-container\">\n      \n        <h3 class=\"element-media__title\">KiwiRail\u2019s customers discuss the value of rail</h3>\n      \n\n      \n        <p>We\u2019ve been out in the field with a number of our key customers to find out what\u2019s really important to them. This is an important step in our journey towards greater customer-centricity.<br />\r\nThere\u2019s a lot of great mahi happening across the motu and we\u2019re humbled to work alongside our customers\u2019 organisations helping them to meet their business goals.</p>\n      \n\n      \n    </div>\n  </div>\n</div>\n\n\n  <div class=\"element-media__media\">\n    \n\n    \n      <div id=\"youtube-embed-113\" class=\"youtube-embed__container\">\n  \n  <iframe\n    src=\"\"\n    title=\"Youtube video\"\n    frameborder=\"0\"\n    allowTransparency=\"true\"\n    allowfullscreen\n    data-src=\"//www.youtube.com/embed/sl5uGlaQqrI?rel=0&showinfo=0&controls=1&autohide=1&modestbranding=1&enablejsapi=1&playsinline=1&autoplay=1\">\n  </iframe>\n\n\n  \n    <style>\n  #youtube-embed-113 .youtube-embed__poster {\n    \n    background-image: url(https://i1.ytimg.com/vi/sl5uGlaQqrI/maxresdefault.jpg);\n  \n  }\n</style>\n\n<button type=\"button\" class=\"youtube-embed__poster\" aria-label=\"custom video play button\">\n  <svg viewBox=\"0 0 66 66\" xmlns=\"http://www.w3.org/2000/svg\"><g fill-rule=\"nonzero\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\"><path d=\"M41.5 33l-14 8.5v-17z\"/><circle cx=\"33\" cy=\"33\" r=\"32\"/></g></svg>\n</button>\n\n  \n</div>\n\n\n\n\n    \n  </div>\n\n\n</div>\n\n  \n    <div class=\"element element-media media-left-half\" id=\"e391\">\n\t\n  <style>\n  .element#e391 .intrinsic:after {\n    padding-bottom: calc(1201 / 1800 * 100%);\n  }\n  </style>\n\n\n<div class=\"element-media__content-container\">\n  <div class=\"element-media__content\">\n    <div class=\"element-media__text-container\">\n      \n        <h3 class=\"element-media__title\">Our people</h3>\n      \n\n      \n        <p>KiwiRail is one of New Zealand\u2019s largest employers, with proud staff operating in more than 50 towns and cities across the country.<br />\r\nHistory means a lot to our people \u2013 many are the third or fourth generation in their family to work in rail \u2013 but it is the promise of rail\u2019s future that excites our 4,500 people.</p>\n      \n\n      \n        \n          \n  <a class=\" dn--link\" href=\"/who-we-are/our-people/\">\n    Our people\n  </a>\n\n\n        \n      \n    </div>\n  </div>\n</div>\n\n\n  <div class=\"element-media__media\">\n    \n      <div class=\"element-media__image\">\n        <div class=\"lazyload-container\">\n  <img\n    class=\"lazyload blur-up\"\n    src=\"/assets/Uploads/Ebony-Tipene-Low__QualityWzIwXQ.jpg\"\n    data-src=\"/assets/Uploads/Ebony-Tipene-Low.jpg\"\n    alt=\"Ebony Tipene Low\"\n  />\n</div>\n      </div>\n    \n\n    \n  </div>\n\n\n</div>\n\n  \n    <div class=\"element element-media media-right-half\" id=\"e441\">\n\t\n  <style>\n  .element#e441 .intrinsic:after {\n    padding-bottom: calc(2962 / 5272 * 100%);\n  }\n  </style>\n\n\n<div class=\"element-media__content-container\">\n  <div class=\"element-media__content\">\n    <div class=\"element-media__text-container\">\n      \n        <h3 class=\"element-media__title\">Health, Safety &amp; Wellbeing</h3>\n      \n\n      \n        <p>Of KiwiRail\u2019s four core values, \u2018Care and Protect\u2019 is the one our people live and breathe by.  It is why our Health, Safety &amp; Wellbeing vision is to become the leading health and safety organisation in New Zealand.</p>\n      \n\n      \n        \n          \n  <a class=\" dn--link\" href=\"/who-we-are/safety/\">\n    Read more about our safety vision\n  </a>\n\n\n        \n      \n    </div>\n  </div>\n</div>\n\n\n  <div class=\"element-media__media\">\n    \n      <div class=\"element-media__image\">\n        <div class=\"lazyload-container\">\n  <img\n    class=\"lazyload blur-up\"\n    src=\"/assets/Uploads/Home-page/Media-blocks/DJI_0641__QualityWzIwXQ.jpg\"\n    data-src=\"/assets/Uploads/Home-page/Media-blocks/DJI_0641.jpg\"\n    alt=\"DJI 0641\"\n  />\n</div>\n      </div>\n    \n\n    \n  </div>\n\n\n</div>\n\n  \n    <div class=\"element element-carousel dn--element-carousel\" id=\"e393\">\n\t\n  <div class=\"element-carousel__header\">\n    <h2 class=\"element-carousel__title\">Safety messages from our drivers</h2>\n  </div>\n\n\n<div class=\"element-carousel__container\" data-element-carousel>\n  <div class=\"element-carousel__frame\">\n    <ul class=\"element-carousel__slides\">\n      \n        <li class=\"element-carousel__slide\">\n  \n\n  <div class=\"element-carousel__slide-container\">\n    \n\n    \n      <div id=\"youtube-embed-29\" class=\"youtube-embed__container\">\n  \n  <iframe\n    src=\"\"\n    title=\"Youtube video\"\n    frameborder=\"0\"\n    allowTransparency=\"true\"\n    allowfullscreen\n    data-src=\"//www.youtube.com/embed/qIuziXTkAkA?rel=0&showinfo=0&controls=1&autohide=1&modestbranding=1&enablejsapi=1&playsinline=1&autoplay=1\">\n  </iframe>\n\n\n  \n    <style>\n  #youtube-embed-29 .youtube-embed__poster {\n    \n    background-image: url(https://i1.ytimg.com/vi/qIuziXTkAkA/maxresdefault.jpg);\n  \n  }\n</style>\n\n<button type=\"button\" class=\"youtube-embed__poster\" aria-label=\"custom video play button\">\n  <svg viewBox=\"0 0 66 66\" xmlns=\"http://www.w3.org/2000/svg\"><g fill-rule=\"nonzero\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\"><path d=\"M41.5 33l-14 8.5v-17z\"/><circle cx=\"33\" cy=\"33\" r=\"32\"