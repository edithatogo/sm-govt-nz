{
  "description": "Discovery and archive-onboarding policy for New Zealand government public communication sources.",
  "generated_at": "2026-06-24",
  "homepage_probe": {
    "enabled": true,
    "timeout_seconds": 5,
    "max_pages_per_agency": 1,
    "user_agent": "sm-govt-nz-source-discovery/1.0 (+https://github.com/edithatogo/sm-govt-nz)",
    "common_paths": [
      "/",
      "/news",
      "/news-and-events",
      "/media",
      "/media-releases",
      "/publications",
      "/subscribe",
      "/newsletter",
      "/rss",
      "/feed",
      "/feed.json",
      "/atom.xml",
      "/rss.xml",
      "/.well-known/webfinger",
      "/api",
      "/openapi.json"
    ]
  },
  "platform_archive_policy": {
    "bluesky": {
      "feasibility": "high",
      "archive_status": "ready",
      "access_method": "public_at_protocol",
      "auth": "none",
      "notes": "Public AT Protocol profile and posts can be captured without live-posting side effects."
    },
    "youtube": {
      "feasibility": "medium",
      "archive_status": "candidate",
      "access_method": "public_channel_rss_or_yt_dlp_metadata",
      "auth": "none",
      "notes": "Channel URLs are known, but many handles still need channel-id resolution before RSS archiving is fully automatic."
    },
    "facebook": {
      "feasibility": "medium",
      "archive_status": "candidate",
      "access_method": "meta_graph_api_or_authorized_export",
      "auth": "operator_or_app_authorized",
      "notes": "Official API or authorized export is preferred. Avoid brittle unauthenticated scraping."
    },
    "instagram": {
      "feasibility": "medium",
      "archive_status": "candidate",
      "access_method": "meta_graph_api_or_authorized_export",
      "auth": "operator_or_app_authorized",
      "notes": "Archive capture depends on Meta access and account eligibility."
    },
    "medium": {
      "feasibility": "medium",
      "archive_status": "candidate",
      "access_method": "public_html_or_rss",
      "auth": "none",
      "notes": "Medium publication pages are public and often expose RSS or readable HTML archives."
    },
    "threads": {
      "feasibility": "medium",
      "archive_status": "candidate",
      "access_method": "threads_api_or_authorized_export",
      "auth": "operator_or_app_authorized",
      "notes": "Use Threads API where accounts and app review permit it."
    },
    "linkedin": {
      "feasibility": "low",
      "archive_status": "manual_seed",
      "access_method": "approved_api_or_user_authorized_capture",
      "auth": "operator_authorized",
      "notes": "LinkedIn archiving should use approved API access, owner export, or bounded user-authorized seed capture."
    },
    "x": {
      "feasibility": "low",
      "archive_status": "degraded",
      "access_method": "public_archive_or_lawful_export",
      "auth": "operator_authorized_if_browser_capture",
      "notes": "Prefer account owner export or public archive sources. Treat live web access as degraded."
    },
    "rss": {
      "feasibility": "high",
      "archive_status": "ready",
      "access_method": "public_rss",
      "auth": "none",
      "notes": "RSS/Atom feeds are the easiest repeatable archive source and should be prioritized."
    },
    "website_page": {
      "feasibility": "high",
      "archive_status": "ready",
      "access_method": "bounded_public_html",
      "auth": "none",
      "notes": "Capture only bounded public pages discovered from feeds or explicit source manifests."
    },
    "newsletter": {
      "feasibility": "medium",
      "archive_status": "candidate",
      "access_method": "email_ingress_or_public_archive",
      "auth": "inbox_or_dispatch_token",
      "notes": "Needs explicit subscription and ingress routing before it becomes an automated archive source."
    },
    "substack": {
      "feasibility": "medium",
      "archive_status": "candidate",
      "access_method": "public_html_or_rss",
      "auth": "none",
      "notes": "Substack publication pages are public and commonly expose RSS feeds for archive ingestion."
    },
    "json_feed": {
      "feasibility": "high",
      "archive_status": "ready",
      "access_method": "public_json_feed",
      "auth": "none",
      "notes": "JSON Feed is a first-class feed source when advertised by link rel=alternate or common feed paths."
    },
    "websub": {
      "feasibility": "medium",
      "archive_status": "candidate",
      "access_method": "websub_hub_subscription",
      "auth": "none",
      "notes": "WebSub hubs enable realtime RSS/Atom delivery, but polling remains the authoritative fallback."
    },
    "activitypub": {
      "feasibility": "medium",
      "archive_status": "candidate",
      "access_method": "activitypub_or_webfinger",
      "auth": "none",
      "notes": "ActivityPub/Mastodon-compatible profiles should be reviewed for public outbox/follow collection archive feasibility."
    },
    "api": {
      "feasibility": "medium",
      "archive_status": "candidate",
      "access_method": "public_api_or_openapi",
      "auth": "none_or_token",
      "notes": "Public APIs should be preferred over page scraping when they expose stable public communications records."
    },
    "microformat": {
      "feasibility": "medium",
      "archive_status": "candidate",
      "access_method": "public_html_microformats",
      "auth": "none",
      "notes": "Microformats such as h-feed and h-entry can provide structured public updates when no feed is advertised."
    }
  },
  "heuristics": {
    "trusted_domain_suffixes": [
      ".govt.nz",
      ".parliament.nz",
      ".ac.nz",
      ".mil.nz",
      ".cri.nz",
      ".co.nz",
      ".org.nz"
    ],
    "high_trust_suffixes": [
      ".govt.nz",
      ".parliament.nz",
      ".ac.nz",
      ".mil.nz",
      ".cri.nz"
    ],
    "official_account_terms": [
      "official",
      "new zealand",
      "nz",
      "aotearoa",
      "government",
      "govt",
      "public",
      "board",
      "crown",
      "department",
      "service",
      "library",
      "parliament",
      "ministry",
      "commission",
      "agency",
      "council",
      "authority"
    ],
    "negative_account_terms": [
      "fan",
      "parody",
      "unofficial",
      "archive only",
      "not affiliated"
    ],
    "platform_search_templates": [
      {
        "platform": "facebook",
        "query": "site:facebook.com {agency_name} {domain}"
      },
      {
        "platform": "instagram",
        "query": "site:instagram.com {agency_name} {domain}"
      },
      {
        "platform": "medium",
        "query": "site:medium.com {agency_name} {domain}"
      },
      {
        "platform": "linkedin",
        "query": "site:linkedin.com/company OR site:linkedin.com/school {agency_name} {domain}"
      },
      {
        "platform": "substack",
        "query": "site:substack.com {agency_name} {domain}"
      },
      {
        "platform": "youtube",
        "query": "site:youtube.com/@ OR site:youtube.com/channel {agency_name} {domain}"
      },
      {
        "platform": "x",
        "query": "site:x.com OR site:twitter.com {agency_name} {domain}"
      },
      {
        "platform": "bluesky",
        "query": "site:bsky.app/profile {agency_name} {domain}"
      },
      {
        "platform": "threads",
        "query": "site:threads.net/@ {agency_name} {domain}"
      },
      {
        "platform": "activitypub",
        "query": "site:mastodon.nz OR site:mastodon.social OR site:mas.to {agency_name} {domain}"
      },
      {
        "platform": "json_feed",
        "query": "{agency_name} {domain} \"feed.json\" OR \"JSON Feed\""
      },
      {
        "platform": "api",
        "query": "{agency_name} {domain} \"openapi\" OR \"api\""
      },
      {
        "platform": "microformat",
        "query": "{agency_name} {domain} \"h-feed\" OR \"h-entry\""
      }
    ],
    "learning_file": "conductor/govt_source_discovery_learning.json"
  }
}
