{
  "agency_id": "courts-nz",
  "agency_name": "Courts of New Zealand",
  "archive_only": true,
  "contracts": [
    {
      "id": "courts-nz-bluesky",
      "source_platform": "bluesky",
      "source_kind": "social_feed",
      "display_name": "Courts of New Zealand Bluesky",
      "account": "courtsofnz.bsky.social",
      "url": "https://bsky.app/profile/courtsofnz.bsky.social",
      "access_method": "public_at_protocol",
      "auth": "none",
      "status": "healthy",
      "dedupe_keys": ["at_uri", "canonical_url", "content_hash"],
      "raw_path_template": "historical_archive_raw/bluesky/{yyyy_mm}/{record_id}.json",
      "normalized_path_template": "historical_archive_normalized/bluesky/{yyyy_mm}.jsonl",
      "rate_limit_policy": "Use bounded page sizes and persist cursors. Treat rate limits as degraded source health.",
      "archive_only_guarantee": "Backfills and archive captures must not advance outbound syndication state.",
      "failure_modes": ["rate_limited", "network_error", "schema_changed"]
    },
    {
      "id": "courts-nz-linkedin",
      "source_platform": "linkedin",
      "source_kind": "social_feed",
      "display_name": "Courts of New Zealand LinkedIn",
      "account": "courts-of-new-zealand",
      "url": "https://www.linkedin.com/company/courts-of-new-zealand/posts/?feedView=all",
      "access_method": "approved_api_or_user_authorized_capture",
      "auth": "operator_authorized",
      "status": "auth_required",
      "dedupe_keys": ["linkedin_post_url", "canonical_url", "content_hash"],
      "raw_path_template": "historical_archive_raw/linkedin/{yyyy_mm}/{record_id}.json",
      "normalized_path_template": "historical_archive_normalized/linkedin/{yyyy_mm}.jsonl",
      "rate_limit_policy": "Prefer official export/API. Browser capture must be manual or explicitly user-authorized and bounded.",
      "archive_only_guarantee": "LinkedIn records are evidence inputs only and must never be reposted by this track.",
      "failure_modes": ["auth_required", "rate_limited", "blocked", "schema_changed"]
    },
    {
      "id": "courts-nz-x-archive",
      "source_platform": "x",
      "source_kind": "inactive_social_archive",
      "display_name": "Courts of New Zealand X Archive",
      "account": "courtsofnz",
      "url": "https://x.com/courtsofnz",
      "access_method": "public_archive_or_lawful_export",
      "auth": "operator_authorized_if_browser_capture",
      "status": "degraded",
      "historical_cutoff": "2025-03-23",
      "dedupe_keys": ["tweet_id", "canonical_url", "content_hash"],
      "raw_path_template": "historical_archive_raw/x/{yyyy_mm}/{record_id}.json",
      "normalized_path_template": "historical_archive_normalized/x/{yyyy_mm}.jsonl",
      "rate_limit_policy": "Prefer static public archive sources or exported records. Do not scrape aggressively.",
      "archive_only_guarantee": "X archive records are historical only and must not enter any live posting queue.",
      "failure_modes": ["auth_required", "blocked", "unavailable", "incomplete_archive"]
    },
    {
      "id": "courts-nz-rss-website",
      "source_platform": "courtsofnz.govt.nz",
      "source_kind": "rss_and_website",
      "display_name": "Courts of New Zealand RSS and Website",
      "account": "courtsofnz.govt.nz",
      "url": "https://www.courtsofnz.govt.nz/",
      "access_method": "public_rss_and_html",
      "auth": "none",
      "status": "healthy",
      "seed_pages": [
        "https://www.courtsofnz.govt.nz/",
        "https://www.courtsofnz.govt.nz/home/receiving-notifications-of-judgments-of-public-interest-and-judicial-announcements",
        "https://www.courtsofnz.govt.nz/home/courts-of-new-zealand-social-media-channels",
        "https://www.courtsofnz.govt.nz/publications/speeches-and-papers",
        "https://www.courtsofnz.govt.nz/publications/announcements",
        "https://www.courtsofnz.govt.nz/publications/reports",
        "https://www.courtsofnz.govt.nz/going-to-court/calendar/daily-lists-and-upcoming-cases",
        "https://www.courtsofnz.govt.nz/the-courts/supreme-court/judgments",
        "https://www.courtsofnz.govt.nz/the-courts/court-of-appeal/judgments",
        "https://www.courtsofnz.govt.nz/the-courts/high-court/judgments"
      ],
      "dedupe_keys": ["feed_entry_id", "canonical_url", "content_hash"],
      "raw_path_template": "historical_archive_raw/rss/{yyyy_mm}/{record_id}.json",
      "normalized_path_template": "historical_archive_normalized/rss/{yyyy_mm}.jsonl",
      "rate_limit_policy": "Use feedparser for feeds and bounded HTML fetches for canonical linked pages.",
      "archive_only_guarantee": "RSS and website records may enrich the corpus but must not alter outbound syndication cursors.",
      "failure_modes": ["feed_unavailable", "network_error", "html_changed"]
    },
    {
      "id": "courts-nz-email-judgments",
      "source_platform": "email",
      "source_kind": "judgments_subscription",
      "display_name": "Courts of New Zealand Judgments Email Subscription",
      "account": "judgments-of-public-interest-subscription",
      "url": "https://www.courtsofnz.govt.nz/subscribe",
      "access_method": "cloudflare_email_routing_worker",
      "auth": "github_dispatch_token",
      "status": "auth_required",
      "subscription_sections": [
        "Supreme Court decisions",
        "Court of Appeal decisions",
        "High Court decisions",
        "Supreme Court Leave and Recall Judgments"
      ],
      "dedupe_keys": ["message_id", "canonical_url", "content_hash"],
      "raw_path_template": "historical_archive_raw/email/{yyyy_mm}/{record_id}.eml",
      "normalized_path_template": "historical_archive_normalized/email/{yyyy_mm}.jsonl",
      "rate_limit_policy": "Accept provider webhook events one message at a time. Retry GitHub dispatch with idempotency keys.",
      "archive_only_guarantee": "Email notifications are corpus inputs only and must never create outbound posts directly.",
      "failure_modes": ["auth_required", "dispatch_failed", "malformed_email", "provider_outage"]
    }
  ],
  "dataset_outputs": {
    "hugging_face": {
      "enabled": true,
      "secret_requirements": ["HF_TOKEN", "HF_DATASET_REPO_ID"],
      "artifacts": ["normalized_jsonl", "normalized_parquet", "manifest", "dataset_card"]
    },
    "zenodo": {
      "enabled": true,
      "secret_requirements": ["ZENODO_TOKEN", "ZENODO_DEPOSIT_ENDPOINT"],
      "artifacts": ["release_snapshot", "manifest", "checksums", "citation_metadata"]
    }
  },
  "phase_review_contract": {
    "commit_after_each_task": true,
    "review_after_each_phase": true,
    "review_after_track": true,
    "future_syndication_tracks": "one_platform_account_per_track"
  }
}
