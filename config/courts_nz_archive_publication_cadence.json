{
  "agency_id": "courts-nz",
  "contract_id": "corpus-social-media-government-nz-publication-cadence",
  "canonical_dataset_name": "corpus-social-media-government-nz",
  "display_title": "New Zealand Government Social Media Corpus/Archive",
  "naming_convention": {
    "dataset_type": "corpus",
    "corpus_type": "social-media",
    "subject_scope": "government",
    "jurisdiction": "nz"
  },
  "metadata_tags": [
    "corpus",
    "social-media",
    "government",
    "new-zealand",
    "public-records",
    "rss",
    "bluesky"
  ],
  "source_collections": [
    "courts-nz"
  ],
  "archive_capture": {
    "workflow": "Archive Sources",
    "cadence": "every_6_hours",
    "archive_only": true
  },
  "hugging_face": {
    "repo_id": "edithatogo/corpus-social-media-government-nz",
    "url": "https://huggingface.co/datasets/edithatogo/corpus-social-media-government-nz",
    "cadence": "monthly_scheduled_release",
    "workflow": "Publish Archives",
    "workflow_target": "huggingface",
    "requires_secret": "HF_TOKEN",
    "publishes_external_artifacts": true,
    "notes": "Scheduled Publish Archives runs publish monthly to Hugging Face and Zenodo using dynamic release versions. They must not run more frequently than monthly without manual review."
  },
  "zenodo": {
    "doi": "10.5281/zenodo.20690547",
    "conceptdoi": "10.5281/zenodo.20690546",
    "url": "https://zenodo.org/records/20690547",
    "cadence": "manual_exception_release_snapshot",
    "workflow": "Publish Zenodo Deposition",
    "requires_secret": "ZENODO_TOKEN",
    "requires_confirmation": "publish-zenodo-doi",
    "publishes_external_artifacts": false,
    "notes": "Manual Zenodo releases are exception releases only; routine DOI publication occurs through the monthly scheduled social-media release."
  },
  "manual_publish_archives": {
    "workflow": "Publish Archives",
    "default_mode": "artifact_only",
    "publish_flag": "publish=true",
    "publication_targets": [
      "huggingface",
      "zenodo",
      "all"
    ],
    "notes": "Manual runs default to artifact-only. External publication requires publish=true and an explicit target."
  },
  "status_report": {
    "path": "conductor/archive_publication_status.json",
    "committed_by_workflow": true,
    "records": [
      "mode",
      "requested_targets",
      "artifact",
      "hugging_face",
      "zenodo"
    ]
  },
  "guardrails": {
    "archive_capture_independent_of_outbound_syndication": true,
    "manual_runs_default_to_artifact_only": true,
    "scheduled_runs_must_not_publish_zenodo": false,
    "zenodo_requires_manual_release_review": false
  }
}
