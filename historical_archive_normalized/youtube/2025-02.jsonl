{"agency_id": "fire-and-emergency-nz", "canonical_url": "https://www.youtube.com/watch?v=ZCVE95rDCvo", "captured_at": "2026-06-25T07:48:22+00:00", "content": "Urban Search and Rescue patient care\n\n⚠This video contains fake blood, special effects and actors simulating injuries.\n\nHato Hone St John medics are a crucial part of our Urban Search and Rescue teams. Once we locate trapped people, medics assess whether it’s safe to move them. If they need medical attention first, our medics work in often confined spaces to prepare them for extraction. In extreme cases this may include amputations to get them out.", "content_hash": "4e9e4c4712c25166221954d911eb1591c7a7444a78f23dcb9814487517828d96", "cross_source_ids": {"channel_id": "UCQu-E5AwQWpXspT446EvbNw", "feed_url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCQu-E5AwQWpXspT446EvbNw", "source_id": "fire-and-emergency-nz-youtube-bd1c9f48", "video_id": "ZCVE95rDCvo"}, "extraction_method": "generic_registered_youtube_channel_rss", "media_refs": [], "original_created_at": "2025-02-24T02:12:31+00:00", "raw_path": "historical_archive_raw\\youtube\\2025-02\\79c2d84f63da2bc808a4cad4.json", "record_id": "youtube:79c2d84f63da2bc808a4cad4", "source_account": "Fire and Emergency NZ", "source_kind": "social_profile", "source_platform": "youtube", "source_url": "https://www.youtube.com/@FireandEmergencyNZ"}
