7nga3w4lq4kba6la/bafkreidb3fawzfjpfmycs7ln3onwpu7w6jvnc7lokcsj5kpoljwcc6pgfq", "thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:nyyntdr37nga3w4lq4kba6la/bafkreidb3fawzfjpfmycs7ln3onwpu7w6jvnc7lokcsj5kpoljwcc6pgfq"}, {"alt": "Group photo of multiple people standing together in a hallway with dark flooring. Two large, framed artworks with bold, colourful designs hang on the wall behind the group. The lighting is bright from overhead ceiling panels. At the bottom of the graphic are the New Zealand Government and Ministry of Health logos.", "fullsize": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:nyyntdr37nga3w4lq4kba6la/bafkreibsma6xuopkrxnl6ikfxmr5oq3aiqqcyd5esljfqamxnu5uus6g2i", "thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:nyyntdr37nga3w4lq4kba6la/bafkreibsma6xuopkrxnl6ikfxmr5oq3aiqqcyd5esljfqamxnu5uus6g2i"}], "original_created_at": "2026-03-04T21:12:25.426Z", "raw_path": "historical_archive_raw\\bluesky\\2026-03\\3mgb75hcl3s2v.json", "record_id": "bluesky:3mgb75hcl3s2v", "source_account": "health.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/health.govt.nz"}
