{"agency_id": "ministry-of-health", "canonical_url": "https://bsky.app/profile/health.govt.nz/post/3mmsattclwc2a", "captured_at": "2026-06-24T22:27:14+00:00", "content": "“Diphtheria often begins with mild, cold-like symptoms but can quickly become severe. In New Zealand the vaccines that protect against diphtheria are given as part of the childhood immunisation programme. Immunisation offers the best protection against the disease.", "content_hash": "37a4210a740e520512be6433d0714111433bfe17edb17bd2883bb8ff66935169", "cross_source_ids": {"at_uri": "at://did:plc:nyyntdr37nga3w4lq4kba6la/app.bsky.feed.post/3mmsattclwc2a", "cid": "bafyreidfveljlamssq5bfiuvotsxbqeqdzhmiwmkyrccqocco7bsl6z424", "source_id": "ministry-of-health-bluesky-c521eae2"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2026-05-27T00:29:12.309Z", "raw_path": "historical_archive_raw\\bluesky\\2026-05\\3mmsattclwc2a.json", "record_id": "bluesky:3mmsattclwc2a", "source_account": "health.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/health.govt.nz"}
{"agency_id": "ministry-of-health", "canonical_url": "https://bsky.app/profile/health.govt.nz/post/3mmsatqicbk2a", "captured_at": "2026-06-24T22:27:14+00:00", "content": "The Ministry has received a few questions over the past week about the emerging diphtheria outbreak in Australia. The short answer is a) the risk to New Zealand remains low and b) we are in regular contact with Australian health authorities about the emerging outbreak.", "content_hash": "1dd0c931b3269e9f6bf9bd8b307ffc592604df7e7312d25db230a7480b38266c", "cross_source_ids": {"at_uri": "at://did:plc:nyyntdr37nga3w4lq4kba6la/app.bsky.feed.post/3mmsatqicbk2a", "cid": "bafyreidmjzfjr3zuvltytsr66yh3fp3hwrygwr4rt5poezjoesxwajvzbu", "source_id": "ministry-of-health-bluesky-c521eae2"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [{"alt": "Image of text that says \"Diphtheria in Australia. The risk to New Zealand remains low and we are in regular contact with Australian health authorities about the emerging outbreak. Immunisation offers the best protection against the disease.\" The logos for the NZ Government and Ministry of Health are at the bottom.", "fullsize": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:nyyntdr37nga3w4lq4kba6la/bafkreigbbvq6mx26exyctyqn33grht6j33nxsb7ggfu4jtxultlqvej6fi", "thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:nyyntdr37nga3w4lq4kba6la/bafkreigbbvq6mx26exyctyqn33grht6j33nxsb7ggfu4jtxultlqvej6fi"}], "original_created_at": "2026-05-27T00:29:12.308Z", "raw_path": "historical_archive_raw\\bluesky\\2026-05\\3mmsatqicbk2a.json", "record_id": "bluesky:3mmsatqicbk2a", "source_account": "health.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/health.govt.nz"}
{"agency_id": "ministry-of-health", "canonical_url": "https://bsky.app/profile/health.govt.nz/post/3mmffom6hx22c", "captured_at": "2026-06-24T22:27:14+00:00", "content": "News Alert: www.medsafe.govt.nz/safety/Alerts/Consumer-advisory-Unapproved-peptide-products-health-warning.asp\nCARM Report: pophealth.my.site.com/carmreportnz/s", "content_hash": "ab70c3e864668b4f1660cb01de685198794765dd8197f5d887ca3aa67d76461d", "cross_source_ids": {"at_uri": "at://did:plc:nyyntdr37nga3w4lq4kba6la/app.bsky.feed.post/3mmffom6hx22c", "cid": "bafyreihk7mcuulp2lvv7dwgrclqhncipudgtyn5az2tnhh6ldhgifzdp6a", "source_id": "ministry-of-health-bluesky-c521eae2"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2026-05-21T21:51:12.132Z", "raw_path": "historical_archive_raw\\bluesky\\2026-05\\3mmffom6hx22c.json", "record_id": "bluesky:3mmffom6hx22c", "source_account": "health.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/health.govt.nz"}
