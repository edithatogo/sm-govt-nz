{"agency_id": "health-nz", "canonical_url": "https://bsky.app/profile/healthnz.govt.nz/post/3m4rrgvlhec2w", "captured_at": "2026-06-24T22:27:12+00:00", "content": "Health providers! Keen to support this week's Measles Immunisation Week? Here's info and stuff you can use for the week 👇🏾\nwww.tewhatuora.govt.nz/for-health-professionals/clinical-guidance/diseases-and-conditions/measles/national-measles-immunisation-week-3-to-7-november-2025", "content_hash": "3fd56199e44945e10cb3fed3ebec11d054ac504ba28d256d1877e8ecc214686c", "cross_source_ids": {"at_uri": "at://did:plc:mb6xslgolu5gudovx5qgpxmv/app.bsky.feed.post/3m4rrgvlhec2w", "cid": "bafyreig23eqz2dgfz4u7tycpja3xjqflrngrthwgzzv2qe574pwi53hzxe", "source_id": "health-nz-bluesky-50ecdc9e"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-11-04T05:10:29.277Z", "raw_path": "historical_archive_raw\\bluesky\\2025-11\\3m4rrgvlhec2w.json", "record_id": "bluesky:3m4rrgvlhec2w", "source_account": "healthnz.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/healthnz.govt.nz"}
