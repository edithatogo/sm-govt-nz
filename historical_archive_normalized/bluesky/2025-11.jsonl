{"agency_id": "health-nz", "canonical_url": "https://bsky.app/profile/healthnz.govt.nz/post/3m4wkmxnhyl2b", "captured_at": "2026-06-24T22:27:11+00:00", "content": "📞 If you think you have measles, call ahead before visiting your doctor or health provider.\n📍 Check the locations of interest page for updates.\n🔗 More info: info.health.nz/measles-immu... | info.health.nz/MeaslesVaccine", "content_hash": "028522ea76e820cf65d38d9cb9ba39dc120cf2f3db68c286b2157b8b0f1ee176", "cross_source_ids": {"at_uri": "at://did:plc:mb6xslgolu5gudovx5qgpxmv/app.bsky.feed.post/3m4wkmxnhyl2b", "cid": "bafyreicw2fhna2khdxspuqbtnpk6uddby32vtx2t64nuea5cnypgnrljse", "source_id": "health-nz-bluesky-50ecdc9e"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-11-06T02:51:52.097Z", "raw_path": "historical_archive_raw\\bluesky\\2025-11\\3m4wkmxnhyl2b.json", "record_id": "bluesky:3m4wkmxnhyl2b", "source_account": "healthnz.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/healthnz.govt.nz"}
{"agency_id": "health-nz", "canonical_url": "https://bsky.app/profile/healthnz.govt.nz/post/3m4wkmxngzd2b", "captured_at": "2026-06-24T22:27:11+00:00", "content": "🩺 Measles symptoms include:\n• High fever, cough, runny nose, sore red eyes\n• Rash starting on the face, spreading down the body", "content_hash": "2c96d86e60fb69a86624afc9dc5dc4eb8f521ed67a3084ac3f1667d8790357c9", "cross_source_ids": {"at_uri": "at://did:plc:mb6xslgolu5gudovx5qgpxmv/app.bsky.feed.post/3m4wkmxngzd2b", "cid": "bafyreialwnrububau5nd33hwe7xfhmoc75hlviwzk7bwhr2zjkjrkragie", "source_id": "health-nz-bluesky-50ecdc9e"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-11-06T02:51:52.096Z", "raw_path": "historical_archive_raw\\bluesky\\2025-11\\3m4wkmxngzd2b.json", "record_id": "bluesky:3m4wkmxngzd2b", "source_account": "healthnz.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/healthnz.govt.nz"}
{"agency_id": "health-nz", "canonical_url": "https://bsky.app/profile/healthnz.govt.nz/post/3m4wkmxngzc2b", "captured_at": "2026-06-24T22:27:11+00:00", "content": "Get vaccinated at clinics, GPs, Hauora Māori or Pacific health providers, or participating pharmacies - many offer walk-ins. Stay home if you're unwell and watch for symptoms.", "content_hash": "cf37c49b4fa850b51f425ca161004463c92f810b1af0f5d7f4a0b509065ac1e1", "cross_source_ids": {"at_uri": "at://did:plc:mb6xslgolu5gudovx5qgpxmv/app.bsky.feed.post/3m4wkmxngzc2b", "cid": "bafyreieuqoulokvr4a3t6fp7b4akg2j6oj7n4na6gdxg2w3cqhe7wbbuae", "source_id": "health-nz-bluesky-50ecdc9e"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-11-06T02:51:52.095Z", "raw_path": "historical_archive_raw\\bluesky\\2025-11\\3m4wkmxngzc2b.json", "record_id": "bluesky:3m4wkmxngzc2b", "source_account": "healthnz.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/healthnz.govt.nz"}
{"agency_id": "health-nz", "canonical_url": "https://bsky.app/profile/healthnz.govt.nz/post/3m4wkmxne3k2b", "captured_at": "2026-06-24T22:27:11+00:00", "content": "More cases are expected, and NZ remains at high risk. \n✅ What you can do. \nImmunisation is your best protection. Two doses of the MMR vaccine protect ~99% of people.\nCheck your immunisation status.", "content_hash": "5884ffddbe451ba793820dc2ab8f5c5e8b1ee26728426bbd3a4d26c9478d445d", "cross_source_ids": {"at_uri": "at://did:plc:mb6xslgolu5gudovx5qgpxmv/app.bsky.feed.post/3m4wkmxne3k2b", "cid": "bafyreiglf6fbmaeky5eizuf6iohqx7syqzu5yuegkr6xqwvkryrm7ctvke", "source_id": "health-nz-bluesky-50ecdc9e"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-11-06T02:51:52.094Z", "raw_path": "historical_archive_raw\\bluesky\\2025-11\\3m4wkmxne3k2b.json", "record_id": "bluesky:3m4wkmxne3k2b", "source_account": "healthnz.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/healthnz.govt.nz"}
