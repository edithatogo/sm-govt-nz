{"agency_id": "ministry-of-health", "canonical_url": "https://bsky.app/profile/health.govt.nz/post/3m4wjbhtyrk2y", "captured_at": "2026-06-24T22:27:16+00:00", "content": "Sometimes, side effects happen when we least expect them. If you feel unwell after taking medicine, don’t ignore it. Talk to your healthcare professional and report it to Medsafe. Your report helps make medicines safer for everyone.\n\n#MedSafetyWeek2025 #MSW #MedSafe #MinistryofHealthNZ", "content_hash": "3eea840d96aaa9ec372f21bc35d8b7f017da8b99fa96880727b57d928d91fdbd", "cross_source_ids": {"at_uri": "at://did:plc:nyyntdr37nga3w4lq4kba6la/app.bsky.feed.post/3m4wjbhtyrk2y", "cid": "bafyreidf6nrw3jhjhn4h5g4icet3ysvqx35juutt4czg7to3ghcs5es5gm", "source_id": "ministry-of-health-bluesky-c521eae2"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-11-06T02:27:35.862Z", "raw_path": "historical_archive_raw\\bluesky\\2025-11\\3m4wjbhtyrk2y.json", "record_id": "bluesky:3m4wjbhtyrk2y", "source_account": "health.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/health.govt.nz"}
