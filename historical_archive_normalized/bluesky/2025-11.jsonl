{"agency_id": "ministry-of-health", "canonical_url": "https://bsky.app/profile/health.govt.nz/post/3m5krvkukzc24", "captured_at": "2026-06-24T22:27:16+00:00", "content": "Today we have launched an animation to encourage young people to learn about the medicines they take to stay well and be aware of the potential risks associated with some medicines during pregnancy: www.health.govt.nz/news/ministr...", "content_hash": "0f0d1185381e887b4bd23929c28cb1f473351a542af1f8ae5138afb11352b6ad", "cross_source_ids": {"at_uri": "at://did:plc:nyyntdr37nga3w4lq4kba6la/app.bsky.feed.post/3m5krvkukzc24", "cid": "bafyreigi2d7r5mmzf2xe7fjcwleitatkth6okuhikuxe2pkw6wk3o2n4ai", "source_id": "ministry-of-health-bluesky-c521eae2"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-11-14T03:55:14.817Z", "raw_path": "historical_archive_raw\\bluesky\\2025-11\\3m5krvkukzc24.json", "record_id": "bluesky:3m5krvkukzc24", "source_account": "health.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/health.govt.nz"}
{"agency_id": "ministry-of-health", "canonical_url": "https://bsky.app/profile/health.govt.nz/post/3m5kkr7q77c2t", "captured_at": "2026-06-24T22:27:16+00:00", "content": "It's World Diabetes Day! Diabetes affects 320k+ New Zealanders. This is projected to hit 500k by 2043. \n\nUnderstand your risk: www.diabetes.org.nz/know-your-risk\nTalk to your GP or nurse \nSupport healthy eating and active living in your whānau. \n#WorldDiabetesDay #DiabetesAwareness #DiabetesLife", "content_hash": "4c51082a6831991bcc081449cd6418ff75458e3f8b4be5b1522baf61df7632ad", "cross_source_ids": {"at_uri": "at://did:plc:nyyntdr37nga3w4lq4kba6la/app.bsky.feed.post/3m5kkr7q77c2t", "cid": "bafyreih2e7jwpvhuwa5fpsfz5ejsv2fvdj7r3yzbsky6mr3olji6bhk5ge", "source_id": "ministry-of-health-bluesky-c521eae2"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-11-14T01:47:32.729Z", "raw_path": "historical_archive_raw\\bluesky\\2025-11\\3m5kkr7q77c2t.json", "record_id": "bluesky:3m5kkr7q77c2t", "source_account": "health.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/health.govt.nz"}
