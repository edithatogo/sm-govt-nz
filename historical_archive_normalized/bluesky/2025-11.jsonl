{"agency_id": "ministry-of-health", "canonical_url": "https://bsky.app/profile/health.govt.nz/post/3m4rgyr3gbc2g", "captured_at": "2026-06-24T22:27:16+00:00", "content": "It’s #MedSafetyWeek (3–9 Nov)! Medicines are helpful in treating illnesses, but can sometimes cause side effects. Use them as directed and report problems to Medsafe. Let’s make medicines safer together.\n\n#MedSafetyWeek2025 #MSW #MedSafe #MinistryofHealthNZ", "content_hash": "953270853864c880f00cfab9d246b05586d5e2e7a8debb2cc897efd2c7c9b7f3", "cross_source_ids": {"at_uri": "at://did:plc:nyyntdr37nga3w4lq4kba6la/app.bsky.feed.post/3m4rgyr3gbc2g", "cid": "bafyreibldop4t7ksfj24e56rionvc5i3ufid2alipbcrfattcm223vrj3i", "source_id": "ministry-of-health-bluesky-c521eae2"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [{"alt": "Illustration of a superhero character flying alongside a dog wearing a cape, approaching a healthcare professional holding a clipboard. The background is blue with clouds and birds. The text says #MedSafetyWeek is displayed at the bottom.", "fullsize": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:nyyntdr37nga3w4lq4kba6la/bafkreiglciedubidgdflz2pvcsjdc4pracaykbetd33odo4tpdgd6gsy3e", "thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:nyyntdr37nga3w4lq4kba6la/bafkreiglciedubidgdflz2pvcsjdc4pracaykbetd33odo4tpdgd6gsy3e"}], "original_created_at": "2025-11-04T02:03:37.376Z", "raw_path": "historical_archive_raw\\bluesky\\2025-11\\3m4rgyr3gbc2g.json", "record_id": "bluesky:3m4rgyr3gbc2g", "source_account": "health.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/health.govt.nz"}
