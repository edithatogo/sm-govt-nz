{"agency_id": "health-nz", "canonical_url": "https://bsky.app/profile/healthnz.govt.nz/post/3m773esuhhk24", "captured_at": "2026-06-24T22:27:11+00:00", "content": "2/2 Travelling overseas? Measles outbreaks are in NZ & other countries. Protect your whānau: \n✅ Check MMR status if born after 1969 \n✅ Vaccinate before travel \n✅ Babies may need an extra dose. \n\nSymptoms? Don’t visit clinics - call Healthline: 0800 611 116.", "content_hash": "395b4e38ea4fb702b8f9aa504894acb60555c19c0716e6fa39b492c0fd885fcf", "cross_source_ids": {"at_uri": "at://did:plc:mb6xslgolu5gudovx5qgpxmv/app.bsky.feed.post/3m773esuhhk24", "cid": "bafyreib5btlo6ujaaejgcvjitxhlo53fmzybqs2hrclea3wu4z4ocme22u", "source_id": "health-nz-bluesky-50ecdc9e"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-12-04T23:03:14.571Z", "raw_path": "historical_archive_raw\\bluesky\\2025-12\\3m773esuhhk24.json", "record_id": "bluesky:3m773esuhhk24", "source_account": "healthnz.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/healthnz.govt.nz"}
