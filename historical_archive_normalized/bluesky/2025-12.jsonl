{"agency_id": "party-green-party", "canonical_url": "https://bsky.app/profile/greens.org.nz/post/3m7qyi3tdos2e", "captured_at": "2026-07-01T16:39:02+00:00", "content": "“This is just a sour cherry on top of a terrible year for our workers, who have been under constant attack under this Government,” says Green Party spokesperson for Workplace Relations, @teanau.bsky.social.\n\nFULL MEDIA RELEASE: www.greens.org.nz/govt_s_chris...", "content_hash": "9cff1034824914da68cc2c630f1e255893ac65c6fbeca1741817b70105236de2", "cross_source_ids": {"at_uri": "at://did:plc:h45wzpjzuv3stm2i765uvqtp/app.bsky.feed.post/3m7qyi3tdos2e", "cid": "bafyreiekvjjwzajpigv63d225edmoufyi5zqxlheauwvs2vcxvkpvdzxl4", "source_id": "party-green-party-bluesky-59c7706d"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-12-12T01:59:20.718Z", "raw_path": "historical_archive_raw/bluesky/2025-12/3m7qyi3tdos2e.json", "record_id": "bluesky:3m7qyi3tdos2e", "source_account": "greens.org.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/greens.org.nz"}
{"agency_id": "party-green-party", "canonical_url": "https://bsky.app/profile/greens.org.nz/post/3m74xnoze5k2e", "captured_at": "2026-07-01T16:39:02+00:00", "content": "The Coalition Government is eroding the principles of transparency & accountability that all New Zealanders deserve from any government.\n\nA Green Government will put people and planet before profit & revoke consents that sidestep long held protections to exploit our environment under the fast-track.", "content_hash": "da45579926a2b210904d13442fe08f744fbf0e4558f0911f4c715dc204a985bd", "cross_source_ids": {"at_uri": "at://did:plc:h45wzpjzuv3stm2i765uvqtp/app.bsky.feed.post/3m74xnoze5k2e", "cid": "bafyreieme2qllxh4tm55zik6z7jy6wl6uphvba746l3edq4gd26nhrn5yq", "source_id": "party-green-party-bluesky-59c7706d"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-12-04T02:51:20.103Z", "raw_path": "historical_archive_raw/bluesky/2025-12/3m74xnoze5k2e.json", "record_id": "bluesky:3m74xnoze5k2e", "source_account": "greens.org.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/greens.org.nz"}
