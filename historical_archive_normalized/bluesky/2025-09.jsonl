{"agency_id": "health-nz", "canonical_url": "https://bsky.app/profile/healthnz.govt.nz/post/3lyw5yrrvok22", "captured_at": "2026-06-24T22:27:13+00:00", "content": "If you're getting into the garden, protect your lungs from Legionnaire's Disease:\n✅ Wear gloves and a mask\n✅ Open potting mix away from your face\n✅ Dampen the mix to reduce dust\n✅ Wash your hands after gardening. More 👇🏾\ninfo.health.nz/conditions-treatments/lungs/legionnaires-disease-legionellosis", "content_hash": "2fe88a801edb62e32de69106f94c2d5ab9acc282938da74150d39202ad3ac64e", "cross_source_ids": {"at_uri": "at://did:plc:mb6xslgolu5gudovx5qgpxmv/app.bsky.feed.post/3lyw5yrrvok22", "cid": "bafyreiaxjy7affa2tbiibfufe6alwweonxo6gpe4shuffgxtfrrkipzitq", "source_id": "health-nz-bluesky-50ecdc9e"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-09-16T01:25:06.617Z", "raw_path": "historical_archive_raw\\bluesky\\2025-09\\3lyw5yrrvok22.json", "record_id": "bluesky:3lyw5yrrvok22", "source_account": "healthnz.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/healthnz.govt.nz"}
