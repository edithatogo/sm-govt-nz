{"agency_id": "ministry-of-health", "canonical_url": "https://bsky.app/profile/health.govt.nz/post/3lzmh5653wk2k", "captured_at": "2026-06-24T22:27:16+00:00", "content": "Today is #WorldPharmacistsDay!\n\nPharmacists are essential to our health system — improving access to medicines and supporting safe use every day. Thank you for all you do!\n\n#ThinkHealthThinkPharmacist #WorldPharmacistsDay #MinistryofHealthNZ", "content_hash": "d044be0cf4a0de88ca260c07bc26e20c0742186ac3137156205c89a7064ba2ab", "cross_source_ids": {"at_uri": "at://did:plc:nyyntdr37nga3w4lq4kba6la/app.bsky.feed.post/3lzmh5653wk2k", "cid": "bafyreia3q3vtlr3ag6hgoxv77eoh5dbn6f7ifsrkkohmcbzawkw7offzaa", "source_id": "ministry-of-health-bluesky-c521eae2"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-09-24T22:07:11.706Z", "raw_path": "historical_archive_raw\\bluesky\\2025-09\\3lzmh5653wk2k.json", "record_id": "bluesky:3lzmh5653wk2k", "source_account": "health.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/health.govt.nz"}
