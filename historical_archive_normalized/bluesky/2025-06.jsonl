{"agency_id": "herenge-a-nuku", "canonical_url": "https://bsky.app/profile/herengaanuku.govt.nz/post/3lrevjdi5yc2v", "captured_at": "2026-07-01T16:39:00+00:00", "content": "Check out our Case Map. This tool offers an overview of most of our outdoor public access cases across the motu. It enhances transparency by showcasing Access Dispute Cases, Enhanced Access Grants, and more. #PublicAccess #NewZealand\nwww.herengaanuku.govt.nz/our-work/new...", "content_hash": "8be8d7139bcf41a3b8249269d17db5024341bac04423dfe798f4f4a7de44ed46", "cross_source_ids": {"at_uri": "at://did:plc:mi3fsmvaki4gnknjgt3wpxew/app.bsky.feed.post/3lrevjdi5yc2v", "cid": "bafyreifeqjto53p6vg3d3lbbqjjb2bh4h44lmwfyzdb3yzjjdb3egez6ey", "source_id": "77b1247840c68d26"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [{"alt": "Screenshot of Herenga ā Nuku Case Map", "fullsize": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:mi3fsmvaki4gnknjgt3wpxew/bafkreidsmfgqdbart3lx2m4uglv4v2ugv423pwtnkfvo57moxkpc4tzzea", "thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:mi3fsmvaki4gnknjgt3wpxew/bafkreidsmfgqdbart3lx2m4uglv4v2ugv423pwtnkfvo57moxkpc4tzzea"}], "original_created_at": "2025-06-12T02:41:41.416Z", "raw_path": "historical_archive_raw/bluesky/2025-06/3lrevjdi5yc2v.json", "record_id": "bluesky:3lrevjdi5yc2v", "source_account": "herengaanuku.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/herengaanuku.govt.nz"}
