{"agency_id": "ministry-of-health", "canonical_url": "https://bsky.app/profile/health.govt.nz/post/3lsfp2sije22g", "captured_at": "2026-06-24T22:27:16+00:00", "content": "Kia ora Sophie, at this stage, we have not received any applications on the use of psilocybin for treating ADHD. If an application is received, it will be assessed by Medsafe.", "content_hash": "4881bf4528c7b2dd63e81482140460d58ee80d244e72cff1817032e6e5ab9673", "cross_source_ids": {"at_uri": "at://did:plc:nyyntdr37nga3w4lq4kba6la/app.bsky.feed.post/3lsfp2sije22g", "cid": "bafyreifm2vug53zhxagjlffoc5wqdijity5gtmeaajkc6fmkwtbvyfva2q", "source_id": "ministry-of-health-bluesky-c521eae2"}, "extraction_method": "generic_registered_bluesky_public_api", "media_refs": [], "original_created_at": "2025-06-25T03:44:02.761Z", "raw_path": "historical_archive_raw\\bluesky\\2025-06\\3lsfp2sije22g.json", "record_id": "bluesky:3lsfp2sije22g", "source_account": "health.govt.nz", "source_kind": "social_profile", "source_platform": "bluesky", "source_url": "https://bsky.app/profile/health.govt.nz"}
